# Test releases built on top of the image under test (tests/boot/update.sh).
#   VARIANT=next     a healthy new release
#   VARIANT=wrong    a healthy release, signed with a key the appliance does not trust
#   VARIANT=broken   writes into the database volume on start, as a migration
#                    would, and never becomes healthy
ARG BASE=localhost/kamerplanter-appliance:poc
FROM ${BASE}
ARG VARIANT=next
LABEL org.opencontainers.image.version="test-${VARIANT}"
RUN echo "${VARIANT}" >/usr/share/kamerplanter/test-variant \
    && if [ "${VARIANT}" = broken ]; then \
        mkdir -p /usr/share/containers/systemd/kamerplanter-backend.container.d \
                 /usr/lib/systemd/system/kamerplanter-arangodb.service.d \
        && printf '[Container]\nHealthCmd=/bin/false\nHealthStartPeriod=0\n' \
            >/usr/share/containers/systemd/kamerplanter-backend.container.d/90-broken.conf \
        && printf '[Service]\nExecStartPre=/usr/bin/touch /var/lib/containers/storage/volumes/arangodb_data/_data/WRITTEN_BY_BROKEN\n' \
            >/usr/lib/systemd/system/kamerplanter-arangodb.service.d/90-broken.conf; \
    fi
RUN bootc container lint
