# System image of the Kamerplanter appliance (proof of concept, stage 2).
# Fedora 46 is Rawhide while Fedora 46 is in development. Fedora publishes
# these images under moving tags only and removes superseded digests within
# about a day, so this pin breaks once the tag is rebuilt;
# .github/workflows/base-image-mirror.yml copies the base image into the
# project's registry, and this line moves there once the mirror exists.
FROM quay.io/fedora/fedora-bootc:46@sha256:b2df016fdcbcf40fd811aff8f89de1d88fa9f8a4240669daa678d3e15806e9ab

# The release version; bootc shows it as the version of a deployment.
ARG VERSION=dev
LABEL org.opencontainers.image.title="Kamerplanter appliance" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.source="https://github.com/nolte/kamerplanter-appliance"

COPY rootfs/ /

# The key that signs released system images. Updates are verified against it
# (spec/update-and-rollback/ B3); a build without it would install appliances
# that accept no update at all.
COPY keys/system-image.pub /usr/share/kamerplanter/keys/system-image.pub

RUN chmod 0755 /usr/libexec/kamerplanter/configure /usr/bin/kamerplanter-update \
        /usr/lib/systemd/system-generators/kamerplanter-update-window \
    && chmod 0700 /etc/kamerplanter && chmod 0600 /etc/kamerplanter/kamerplanter.env \
    && systemctl enable kamerplanter.target kamerplanter-config.service \
        kamerplanter-update-guard.service kamerplanter-update-health.service \
        kamerplanter-update-fetch.timer kamerplanter-update-apply.timer \
    # bootc's own timer applies updates with an immediate reboot at any hour;
    # kamerplanter-update-*.timer replace it.
    && systemctl mask bootc-fetch-apply-updates.timer

# Updates of the system image must carry a signature by the release key.
# Fedora's default policy stays as it is for every other image; the
# Kamerplanter container images are pinned by digest in their units.
RUN entry='{"type": "sigstoreSigned", "keyPath": "/usr/share/kamerplanter/keys/system-image.pub", "signedIdentity": {"type": "matchRepository"}}' \
    && jq --argjson entry "$entry" '.transports.docker["ghcr.io/nolte/kamerplanter-appliance"] = [$entry]' \
        /usr/share/containers/policy.json >/tmp/policy.json \
    && mv /tmp/policy.json /usr/share/containers/policy.json \
    && chmod 0644 /usr/share/containers/policy.json

# Fail the build when a container unit does not translate.
RUN /usr/lib/systemd/system-generators/podman-system-generator --dryrun >/dev/null

RUN bootc container lint
