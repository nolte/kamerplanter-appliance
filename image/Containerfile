# System image of the Kamerplanter appliance (proof of concept, stage 2).
# Fedora 46 is Rawhide while Fedora 46 is in development. Fedora publishes
# these images under moving tags only and removes superseded digests within
# about a day, so the base comes from the project's mirror of
# quay.io/fedora/fedora-bootc:46 (.github/workflows/base-image-mirror.yml),
# which keeps every digest it has seen; the digest is the upstream one.
FROM ghcr.io/nolte/kamerplanter-appliance-base:46@sha256:3a69e73d1f5015629da2df366846472130a63b72ceb4cf3af419f5dfd92daa6b

# OCI labels (spec/project/dockerfile-best-practices/ in nolte/claude-shared).
# VERSION is the release version; bootc shows it as the version of a
# deployment. REVISION is the commit the image is built from and CREATED that
# commit's time, not the build time, so a rebuild of a commit labels alike.
# The build workflow and `task image:build` pass all three.
ARG VERSION=dev
ARG REVISION=unknown
ARG CREATED=1970-01-01T00:00:00Z
LABEL org.opencontainers.image.title="Kamerplanter appliance" \
      org.opencontainers.image.description="Bootable, self-updating appliance that runs the self-hosted plant-management app Kamerplanter on a single machine" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.created="${CREATED}" \
      org.opencontainers.image.source="https://github.com/nolte/kamerplanter-appliance" \
      org.opencontainers.image.url="https://github.com/nolte/kamerplanter-appliance" \
      org.opencontainers.image.documentation="https://nolte.github.io/kamerplanter-appliance/" \
      org.opencontainers.image.vendor="Kamerplanter" \
      org.opencontainers.image.licenses="MIT"

# cloud-init reads the provisioning data: hostname, network, SSH keys and the
# Kamerplanter settings (spec/distribution-requirements/ §L).
# /etc/cloud/cloud.cfg.d/50-kamerplanter.cfg sets its sources and policy;
# without a source its generator keeps it disabled.
# The install leaves state in /run, /var/cache, /var/lib and /var/log that the
# base image does not carry and bootc container lint warns about; it is
# removed. /var/lib/cloud is created at boot by usr/lib/tmpfiles.d/
# kamerplanter-cloud-init.conf, /run/cloud-init by cloud-init's own entry and
# /var/lib/dhcpcd by dhcpcd's.
RUN dnf -y install cloud-init \
    && dnf clean all \
    && rm -rf /run/cloud-init /run/dnf /var/cache /var/lib/cloud \
        /var/lib/dhcpcd /var/lib/dnf /var/log

COPY rootfs/ /

# The public half of the shared key that signs released system images.
# Updates are verified against it (spec/update-and-rollback/ B3); a build
# without it would install appliances that accept no update at all. Its
# canonical copy is in nolte/gh-plumbing (keys/system-image.pub); the build
# fetches it from a pinned ref and fails when the fingerprint differs. Change
# both values together, and the fingerprint only during a key rotation.
# The ref is the commit of nolte/gh-plumbing#444 until a gh-plumbing release
# contains the key; then it becomes that release tag.
ARG GH_PLUMBING_REF=de8d3192fbad4c30237b77b129d563ff84f40eb6
ARG SYSTEM_IMAGE_KEY_SHA256=35eab2c5b1a413e82ebd8919f2158e68af7c165da4535533ebf15a9f9a8bd084
RUN install -d -m 0755 /usr/share/kamerplanter/keys \
    && curl -fsSL --retry 3 -o /usr/share/kamerplanter/keys/system-image.pub \
        "https://raw.githubusercontent.com/nolte/gh-plumbing/${GH_PLUMBING_REF}/keys/system-image.pub" \
    && echo "${SYSTEM_IMAGE_KEY_SHA256}  /usr/share/kamerplanter/keys/system-image.pub" | sha256sum -c - \
    && chmod 0644 /usr/share/kamerplanter/keys/system-image.pub

RUN chmod 0755 /usr/libexec/kamerplanter/configure /usr/libexec/kamerplanter/disks \
        /usr/libexec/kamerplanter/provisioning /usr/libexec/kamerplanter/scrub-cloud-init \
        /usr/bin/kamerplanter-update \
        /usr/lib/systemd/system-generators/kamerplanter-update-window \
    && chmod 0700 /etc/kamerplanter && chmod 0600 /etc/kamerplanter/kamerplanter.env \
    && systemctl enable kamerplanter.target kamerplanter-config.service \
        kamerplanter-provisioning.service kamerplanter-cloud-init-scrub.service \
        kamerplanter-metadata-guard.service \
        kamerplanter-data-disk.service kamerplanter-backup-disk.service \
        kamerplanter-update-guard.service kamerplanter-update-health.service \
        kamerplanter-update-fetch.timer kamerplanter-update-apply.timer \
    # bootc's own timer applies updates with an immediate reboot at any hour;
    # kamerplanter-update-*.timer replace it.
    && systemctl mask bootc-fetch-apply-updates.timer

# Updates of the system image must carry a signature by the release key.
# Fedora's default policy stays as it is for every other image; the
# Kamerplanter container images are pinned by digest in their units.
RUN entry='{"type": "sigstoreSigned", "keyPath": "/usr/share/kamerplanter/keys/system-image.pub", "signedIdentity": {"type": "matchRepository"}}' \
    && jq --argjson entry "$entry" '.transports.docker["ghcr.io/nolte/kamerplanter-appliance"] = [$entry]' \
        /usr/share/containers/policy.json >/tmp/policy.json \
    && mv /tmp/policy.json /usr/share/containers/policy.json \
    && chmod 0644 /usr/share/containers/policy.json

# Fail the build when a container unit does not translate.
RUN /usr/lib/systemd/system-generators/podman-system-generator --dryrun >/dev/null

RUN bootc container lint
