[Unit]
PartOf=kamerplanter.target
Description=Kamerplanter Valkey
Requires=kamerplanter-config.service
After=kamerplanter-config.service

[Container]
ContainerName=valkey
Image=docker.io/valkey/valkey:9-alpine@sha256:bf09d58e96d6b4524a15396b65b242bbe18beebbcc15a04d8ee75ddac62fae0b
Network=kamerplanter.network
Volume=valkey.volume:/data
HealthCmd=valkey-cli ping
HealthInterval=10s
HealthTimeout=5s
HealthRetries=5
HealthOnFailure=kill
Notify=healthy

[Service]
Restart=always
# The first start pulls the image from the registry.
TimeoutStartSec=900

[Install]
WantedBy=kamerplanter.target
