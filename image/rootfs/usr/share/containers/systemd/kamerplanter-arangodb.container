[Unit]
Description=Kamerplanter ArangoDB

[Container]
ContainerName=arangodb
Image=docker.io/library/arangodb:3.12@sha256:c9e1107262f21ebc3b09ac9b3b3dcf70ad99a29f65a3b88ec087bd5d886a2cec
Network=kamerplanter.network
Volume=arangodb.volume:/var/lib/arangodb3
EnvironmentFile=/run/kamerplanter/arangodb.env
# The image ships neither curl nor an unauthenticated /_api/version, so the
# upstream Compose health check cannot pass; this endpoint needs no login.
HealthCmd=wget -q -O /dev/null http://127.0.0.1:8529/_admin/server/availability
HealthInterval=10s
HealthTimeout=5s
HealthRetries=5
HealthStartPeriod=60s
HealthOnFailure=kill
Notify=healthy

[Service]
# The first start pulls the image from the registry.
TimeoutStartSec=900
# The first start creates the database with this password, also when the
# start later fails, so it is pinned before the container runs.
ExecStartPre=/usr/libexec/kamerplanter/configure pin ARANGODB_PASSWORD
