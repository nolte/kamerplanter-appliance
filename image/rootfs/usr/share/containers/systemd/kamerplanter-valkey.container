[Unit]
Description=Kamerplanter Valkey

[Container]
ContainerName=valkey
Image=docker.io/valkey/valkey:9-alpine@sha256:3ad5a213cb1bc2fd4a113c89b6248a88655a6bf1dda69519d04e03cd3e3d2742
Network=kamerplanter.network
Volume=valkey.volume:/data
HealthCmd=valkey-cli ping
HealthInterval=10s
HealthTimeout=5s
HealthRetries=5
HealthOnFailure=kill
Notify=healthy

[Service]
# The first start pulls the image from the registry.
TimeoutStartSec=900
