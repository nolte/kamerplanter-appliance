[Unit]
Description=Kamerplanter Valkey

[Container]
ContainerName=valkey
Image=docker.io/valkey/valkey:9-alpine@sha256:c8e2d17498838af5d91e12eb7c11220b3434a7b7131a333e3af52ad5e0b80882
Network=kamerplanter.network
Volume=valkey.volume:/data
HealthCmd=valkey-cli ping
HealthInterval=10s
HealthTimeout=5s
HealthRetries=5
HealthOnFailure=kill
Notify=healthy

[Service]
# The first start pulls the image from the registry.
TimeoutStartSec=900
