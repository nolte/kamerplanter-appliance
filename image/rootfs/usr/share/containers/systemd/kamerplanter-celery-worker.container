[Unit]
Description=Kamerplanter background worker
# After the API: it applies the migrations and pins the values the workers
# encrypt and key data with, so no task runs against an unmigrated schema
# or with values that are not yet protected.
Requires=kamerplanter-backend.service
After=kamerplanter-backend.service

[Container]
ContainerName=celery-worker
Image=ghcr.io/nolte/kamerplanter-backend:0.4.2@sha256:ba9dd4a150a0ad96e61ac190665285ec4ce9eaf7a745cc18b5a097045577cc4c
Network=kamerplanter.network
EnvironmentFile=/run/kamerplanter/app.env
Exec=celery -A app.tasks worker --loglevel=info

[Service]
# The first start pulls the image from the registry.
TimeoutStartSec=900
