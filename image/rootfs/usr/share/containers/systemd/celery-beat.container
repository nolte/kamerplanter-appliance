[Unit]
Description=Kamerplanter task scheduler
Requires=arangodb.service valkey.service
After=arangodb.service valkey.service

[Container]
ContainerName=celery-beat
Image=ghcr.io/nolte/kamerplanter-backend:0.4.2@sha256:ba9dd4a150a0ad96e61ac190665285ec4ce9eaf7a745cc18b5a097045577cc4c
Network=kamerplanter.network
EnvironmentFile=/usr/share/kamerplanter/kamerplanter.env
EnvironmentFile=/etc/kamerplanter/secrets.env
Exec=celery -A app.tasks beat --loglevel=info

[Service]
Restart=always
# The first start pulls the image from the registry.
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
