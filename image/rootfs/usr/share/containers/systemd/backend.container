[Unit]
PartOf=kamerplanter.target
Requires=kamerplanter-config.service
After=kamerplanter-config.service
Description=Kamerplanter API
Requires=arangodb.service valkey.service
After=arangodb.service valkey.service

[Container]
ContainerName=backend
Image=ghcr.io/nolte/kamerplanter-backend:0.4.2@sha256:ba9dd4a150a0ad96e61ac190665285ec4ce9eaf7a745cc18b5a097045577cc4c
Network=kamerplanter.network
PublishPort=8000:8000
EnvironmentFile=/usr/share/kamerplanter/kamerplanter.env
EnvironmentFile=/etc/kamerplanter/secrets.env
EnvironmentFile=/etc/kamerplanter/kamerplanter.env
HealthCmd=curl -sf http://localhost:8000/api/v1/health/live
HealthInterval=10s
HealthTimeout=5s
HealthRetries=5
HealthStartPeriod=60s
HealthOnFailure=kill
Notify=healthy

[Service]
Restart=always
# The first start pulls the image from the registry.
TimeoutStartSec=900

[Install]
WantedBy=kamerplanter.target
