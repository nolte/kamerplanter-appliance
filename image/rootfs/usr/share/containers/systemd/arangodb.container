[Unit]
PartOf=kamerplanter.target
Description=Kamerplanter ArangoDB
Requires=kamerplanter-config.service
After=kamerplanter-config.service

[Container]
ContainerName=arangodb
Image=docker.io/library/arangodb:3.12@sha256:e48adfc58986a10e0316aa23ccae95ca580d880a41c76a8f0df68f9c29b470f2
Network=kamerplanter.network
Volume=arangodb.volume:/var/lib/arangodb3
EnvironmentFile=/run/kamerplanter/arangodb.env
# The image ships neither curl nor an unauthenticated /_api/version, so the
# upstream Compose health check cannot pass; this endpoint needs no login.
HealthCmd=wget -q -O /dev/null http://127.0.0.1:8529/_admin/server/availability
HealthInterval=10s
HealthTimeout=5s
HealthRetries=5
HealthStartPeriod=60s
HealthOnFailure=kill
Notify=healthy

[Service]
Restart=always
# From here on the database exists with this password.
ExecStartPost=/usr/libexec/kamerplanter/configure pin ARANGODB_PASSWORD
# The first start pulls the image from the registry.
TimeoutStartSec=900

[Install]
WantedBy=kamerplanter.target
