# Static settings of the Kamerplanter services. Secrets are generated at
# first boot into /etc/kamerplanter/secrets.env.
ARANGODB_HOST=arangodb
ARANGODB_PORT=8529
ARANGODB_DATABASE=kamerplanter
ARANGODB_USERNAME=root
REDIS_URL=redis://valkey:6379/0
DEBUG=false
REQUIRE_EMAIL_VERIFICATION=false
# CORS_ORIGINS and FRONTEND_URL are not set here: when no layer sets them,
# the configuration check derives them on every boot from the device's host
# name and addresses, with localhost among the origins.
KAMERPLANTER_MODE=light
TIMESCALEDB_ENABLED=false
VECTORDB_ENABLED=false
# Updates (spec/update-and-rollback/): start of the nightly maintenance
# window in local time, the minutes a new version gets to become healthy
# before it is rolled back, and the days a pre-update backup is kept (at
# least 3; a smaller number counts as 3).
UPDATE_WINDOW=03:00
UPDATE_HEALTH_TIMEOUT=20
UPDATE_BACKUP_KEEP_DAYS=7
# Data disk and backup disk (spec/distribution-requirements/ E6-E16), both
# optional: name a local disk by its /dev/disk/by-id/ or /dev/disk/by-uuid/
# path to keep the data on it (DATA_DISK, label kp-data) or the pre-update
# backups (BACKUP_DISK, label kp-backup). These settings count only while no
# data disk is set up, since this file then moves onto the data disk; name a
# disk with /usr/libexec/kamerplanter/disks name data|backup PATH [force]
# instead, which keeps the naming on the system disk. A provisioner passes the
# same as the system credential kamerplanter.data-disk or
# kamerplanter.backup-disk. A blank disk is formatted, a disk that carries the
# label already is used as it is, and a disk with another file system or
# partition table only with DATA_DISK_FORCE=1 or BACKUP_DISK_FORCE=1
# (credential …-disk-force), once per device. The system disk and a mounted
# disk are never formatted. Empty: no such disk.
# Once set up, the disk is recorded in /var/lib/kamerplanter/disks/ and found
# by its label on every boot; see: /usr/libexec/kamerplanter/disks status
# The data disk then holds /etc/kamerplanter (this file's overrides and the
# secrets), the pins and the database volumes, at their usual paths. Named on
# an appliance that holds data already, the disk receives that data at the
# next start; the copy on the system disk is deleted UPDATE_BACKUP_KEEP_DAYS
# after the services passed their health check from the disk, and returned
# to when they do not.
# Encryption (LUKS2) is not a setting here, since this file moves onto the
# data disk: the provisioner supplies the key of a blank disk as the system
# credential kamerplanter.data-disk-key or kamerplanter.backup-disk-key, or in
# the file of that name in /var/lib/kamerplanter/disks/keys/ (root, 0600,
# 32 to 8192 bytes). The appliance never generates a key.
DATA_DISK=
DATA_DISK_FORCE=0
BACKUP_DISK=
BACKUP_DISK_FORCE=0
