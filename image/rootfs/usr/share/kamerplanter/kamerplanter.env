# Static settings of the Kamerplanter services. Secrets are generated at
# first boot into /etc/kamerplanter/secrets.env.
ARANGODB_HOST=arangodb
ARANGODB_PORT=8529
ARANGODB_DATABASE=kamerplanter
ARANGODB_USERNAME=root
REDIS_URL=redis://valkey:6379/0
DEBUG=false
REQUIRE_EMAIL_VERIFICATION=false
CORS_ORIGINS=["http://localhost:8080"]
KAMERPLANTER_MODE=light
TIMESCALEDB_ENABLED=false
VECTORDB_ENABLED=false
# Updates (spec/update-and-rollback/): start of the nightly maintenance
# window in local time, the minutes a new version gets to become healthy
# before it is rolled back, and the days a pre-update backup is kept.
UPDATE_WINDOW=03:00
UPDATE_HEALTH_TIMEOUT=20
UPDATE_BACKUP_KEEP_DAYS=7
