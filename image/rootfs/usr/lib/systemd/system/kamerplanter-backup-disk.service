[Unit]
Description=Find, check and mount the Kamerplanter backup disk
Documentation=file:///usr/libexec/kamerplanter/disks
# kamerplanter-update-guard.service, which writes the pre-update backup,
# requires this unit and is ordered after it. A missing backup disk does not
# fail it (the backup goes to the next location); a label on more than one
# device or under another UUID does, and keeps the services stopped
# (spec/distribution-requirements/ E8). After the data disk, so that two
# set-ups never run at once.
DefaultDependencies=no
After=local-fs.target systemd-udev-trigger.service kamerplanter-data-disk.service
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/kamerplanter/disks start backup
ImportCredential=kamerplanter.data-disk
ImportCredential=kamerplanter.data-disk-force
ImportCredential=kamerplanter.backup-disk
ImportCredential=kamerplanter.backup-disk-force
TimeoutStartSec=infinity

[Install]
WantedBy=kamerplanter.target
