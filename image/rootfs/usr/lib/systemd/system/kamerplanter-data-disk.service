[Unit]
Description=Find, check and mount the Kamerplanter data disk
Documentation=file:///usr/libexec/kamerplanter/disks
# Everything that reads the configuration or the data runs after this unit:
# kamerplanter-config.service, kamerplanter-update-guard.service and
# kamerplanter-update-health.service require it and are ordered after it, and
# every Kamerplanter container requires the first two. Without a data disk set
# up or named, this unit does nothing. When one is set up but missing, it
# fails and none of them starts (spec/distribution-requirements/ E12); once
# the disk is back, `systemctl restart kamerplanter.target` runs it again.
# Not part of kamerplanter.target, so restarting the target does not restart
# the units that require this one.
#
# With a data disk, it also binds the disk's locations onto
# /etc/kamerplanter, /var/lib/kamerplanter/pinned and the two database
# volumes, so the configuration, the secrets, the pins and the data live on
# the disk (E9); Podman creates the volumes (arangodb.volume, valkey.volume)
# only after this unit. When the disk's user file sets another UPDATE_WINDOW
# than the one the generator read at boot, it runs `systemctl daemon-reload`
# so the maintenance window follows it.
#
# A disk named on an appliance whose system disk holds data already receives
# that data first (spec/distribution-requirements/ E11): it is copied onto the
# disk, compared and synced before anything is bound, and the copy on the
# system disk is kept, underneath the binds, until the services have passed
# the health check from the disk (kamerplanter-update-health.service, which
# this unit starts after a move) and UPDATE_BACKUP_KEEP_DAYS have passed.
# When that check fails, it restarts this unit, which returns to the system
# copy and no longer uses the disk. To move without a reboot, run:
# systemctl restart kamerplanter-data-disk.service (it stops the services
# that require it first, and starts them again after).
#
# An encrypted data disk is opened as /dev/mapper/kamerplanter-data with the
# key stored on the system disk or supplied as the credential
# kamerplanter.data-disk-key (spec/distribution-requirements/ E14). When the
# unit stops, after every unit that uses the disk, it unbinds, unmounts and
# closes the disk, in that order. The mount units systemd makes for these
# mounts are ordered before local-fs.target, and this unit after it, so at
# shutdown this unit stops first and finds them all still in place; it must
# not be ordered before those mount units, which would be a cycle.
DefaultDependencies=no
After=local-fs.target systemd-udev-trigger.service
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/kamerplanter/disks start data
ExecStop=/usr/libexec/kamerplanter/disks stop data
# The provisioner may name the disks as system credentials; both are read, so
# one disk is never named as data disk and as backup disk.
ImportCredential=kamerplanter.data-disk
ImportCredential=kamerplanter.data-disk-force
ImportCredential=kamerplanter.backup-disk
ImportCredential=kamerplanter.backup-disk-force
# The key of an encrypted data disk; only this unit reads it.
ImportCredential=kamerplanter.data-disk-key
# Formatting and checking a large disk take as long as they take.
TimeoutStartSec=infinity

[Install]
WantedBy=kamerplanter.target
