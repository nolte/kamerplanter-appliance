[Unit]
Description=Delete the copies of the provisioning data that cloud-init keeps
Documentation=file:///usr/libexec/kamerplanter/scrub-cloud-init
# On every boot, once the provisioning step has renewed the provisioning layer
# and staged the secrets, the configuration check has taken them over (or
# failed), and once cloud-init's last stage is through, which
# still reads its cache, the copies of the user-data that cloud-init keeps
# under /var/lib/cloud and /run/cloud-init are deleted and the provisioned
# secrets removed from its logs (spec/distribution-requirements/ L15).
# cloud-init writes them again on every boot while the source stays attached,
# so this runs on every boot, also on one without provisioning data, which
# finds nothing to do. After= only: when cloud-init's generator keeps it
# disabled, its units are not part of the boot and nothing waits for them
# (L4). cloud-final.service is ordered after multi-user.target; this unit is
# part of kamerplanter.target, which multi-user.target does not wait for.
# The staged secrets in /run/kamerplanter-provisioning/ are not touched: the
# configuration check takes them over and deletes them.
After=kamerplanter-provisioning.service kamerplanter-config.service cloud-final.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/kamerplanter/scrub-cloud-init

[Install]
WantedBy=kamerplanter.target
