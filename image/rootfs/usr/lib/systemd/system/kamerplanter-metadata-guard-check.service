[Unit]
Description=Load the metadata rules again, in case something removed or changed them
Documentation=file:///usr/share/kamerplanter/nftables/metadata-guard.nft
# Started every minute by kamerplanter-metadata-guard-check.timer. The rules
# that keep every user but root, and every container, from the metadata
# service (spec/distribution-requirements/ L16) live only in the kernel: an
# `nft flush ruleset`, `nft delete table` or `nft flush chain` by hand, or a
# firewall tool that replaces the whole ruleset, removes or empties them while
# the guard unit still reads as active. nftables.service, which flushes on
# reload and stop (and on start with the sample main.nft), is masked in the
# image; this check covers whatever else does it.
# Every run loads the image's rules file again, whether the table is there or
# not: a table that is present may have been flushed or edited, and the file
# replaces it whole in one transaction, so the rules are never absent while
# it loads. A missing table is also reported in the journal as a warning. The
# only cost is that the rules' counters start from zero every minute.
# It never restarts or stops kamerplanter-metadata-guard.service: the
# containers require that unit (kamerplanter-.container.d/10-kamerplanter.conf),
# so a restart would stop and start every one of them.
After=kamerplanter-metadata-guard.service

[Service]
Type=oneshot
# A run every minute would otherwise put systemd's start and finish lines
# into the journal every minute; the warning below and a failure still pass.
LogLevelMax=notice
# nft's own error lines carry no priority prefix; at the default info level
# LogLevelMax would drop them and a failure would show without its reason.
SyslogLevel=err
# "<4>" sends the line to the journal at priority warning.
ExecStart=/bin/sh -c '/usr/sbin/nft list table inet kamerplanter_metadata >/dev/null 2>&1 || echo "<4>the metadata rules were removed; loading them again" >&2; exec /usr/sbin/nft -f /usr/share/kamerplanter/nftables/metadata-guard.nft'
