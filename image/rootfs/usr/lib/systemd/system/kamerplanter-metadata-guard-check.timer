[Unit]
Description=Load the metadata rules again every minute
Documentation=file:///usr/share/kamerplanter/nftables/metadata-guard.nft
# Runs kamerplanter-metadata-guard-check.service, which loads the rules
# again (spec/distribution-requirements/ L16): when something removed or
# changed them, the metadata service stays open for at most about a minute.

[Timer]
OnBootSec=1min
OnUnitActiveSec=1min
AccuracySec=10s

[Install]
WantedBy=timers.target
