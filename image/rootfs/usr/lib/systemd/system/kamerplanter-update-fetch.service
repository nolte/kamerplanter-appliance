[Unit]
Description=Download and stage a new Kamerplanter appliance release
Documentation=file:///usr/bin/kamerplanter-update
ConditionPathExists=/run/ostree-booted
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Also deletes what UPDATE_BACKUP_KEEP_DAYS lets go: old pre-update backups,
# and the copy on the system disk of data moved onto a data disk
# (/usr/libexec/kamerplanter/disks cleanup), also when nothing is fetched.
ExecStart=/usr/bin/kamerplanter-update fetch
Nice=10
IOSchedulingClass=idle
