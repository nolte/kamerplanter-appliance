[Unit]
Description=Prepare and check the Kamerplanter configuration
PartOf=kamerplanter.target
# The configuration may live on the data disk, and configure generates
# secrets: it never runs while a data disk that is set up is missing.
# Nor on a data disk that a newer release has used: the update guard keeps
# the services stopped then (spec/distribution-requirements/ E13), and an
# older release generates no secret and writes no pin onto that disk.
Requires=kamerplanter-data-disk.service kamerplanter-update-guard.service
After=kamerplanter-data-disk.service kamerplanter-update-guard.service
# The provisioning layer of this boot is in place before the check
# (spec/distribution-requirements/ L17). After= only: without provisioning
# data that unit keeps the layer as it is and finishes at once.
After=kamerplanter-provisioning.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/kamerplanter/configure

[Install]
WantedBy=kamerplanter.target
