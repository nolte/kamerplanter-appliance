[Unit]
Description=Prepare and check the Kamerplanter configuration
PartOf=kamerplanter.target
# The configuration may live on the data disk, and configure generates
# secrets: it never runs while a data disk that is set up is missing.
# Nor on a data disk that a newer release has used: the update guard keeps
# the services stopped then (spec/distribution-requirements/ E13), and an
# older release generates no secret and writes no pin onto that disk.
Requires=kamerplanter-data-disk.service kamerplanter-update-guard.service
After=kamerplanter-data-disk.service kamerplanter-update-guard.service
# The provisioning layer of this boot is in place, and the secrets of the
# provisioning data are staged, before the check
# (spec/distribution-requirements/ L17). Without provisioning data that unit
# keeps the layer as it is and finishes at once; it never waits for
# cloud-init. When it fails, the check does not run: it would otherwise
# generate the secrets that the provisioning data was to supply, and keep
# them over the provisioned ones from then on. configure writes a staged
# secret into the secrets file only after the data disk is mounted and
# bound, as everything else it writes.
Requires=kamerplanter-provisioning.service
After=kamerplanter-provisioning.service
# configure derives CORS_ORIGINS and FRONTEND_URL that no layer sets from the
# host name and the addresses of the device, so it runs once the network is
# up, as the containers do. Wants=, not Requires=: without a network the
# check still runs, after NetworkManager-wait-online.service gave up.
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/kamerplanter/configure
# A secret may be supplied as the system credential kamerplanter.secret.<KEY>,
# one per key, for example as an SMBIOS type 11 string; configure fills a key
# that the secrets file does not hold with it, on every start
# (spec/distribution-requirements/ L13). The credentials reach only this unit,
# in its private, root-only $CREDENTIALS_DIRECTORY, never its environment.
ImportCredential=kamerplanter.secret.*
