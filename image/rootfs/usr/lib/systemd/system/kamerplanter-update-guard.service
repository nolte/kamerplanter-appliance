[Unit]
Description=Back up or restore the Kamerplanter data around an update
Documentation=file:///usr/bin/kamerplanter-update
# Runs before any database container touches the data (see the drop-in
# kamerplanter-.container.d/10-kamerplanter.conf), and after the data disk
# and the backup disk are mounted.
Requires=kamerplanter-data-disk.service kamerplanter-backup-disk.service
After=local-fs.target kamerplanter-data-disk.service kamerplanter-backup-disk.service
DefaultDependencies=no
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/kamerplanter-update guard
# Copying the database volumes takes as long as the data is large.
TimeoutStartSec=infinity

[Install]
WantedBy=kamerplanter.target
