[Unit]
Description=Back up or restore the Kamerplanter data around an update
Documentation=file:///usr/bin/kamerplanter-update
# Runs before any database container touches the data (see the drop-in
# kamerplanter-.container.d/10-kamerplanter.conf), and after the data disk
# and the backup disk are mounted. It fails, and so keeps the configuration
# check and every container stopped, while the data disk is marked by a
# newer release than the running one (spec/distribution-requirements/ E13);
# it checks that after a rollback has restored the marker with the data.
# `kamerplanter-update allow-downgrade` overrides it and restarts
# kamerplanter.target, which runs this unit again.
# It fails as well after a rollback whose backup cannot be restored: when it
# lies on a backup disk that is missing or mounted under another identity,
# or does not match the checksum recorded with it (spec/update-and-rollback/
# D10). Once the disk is back, a reboot or `systemctl restart
# kamerplanter-backup-disk.service kamerplanter.target` runs it again.
Requires=kamerplanter-data-disk.service kamerplanter-backup-disk.service
After=local-fs.target kamerplanter-data-disk.service kamerplanter-backup-disk.service
DefaultDependencies=no
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/kamerplanter-update guard
# Copying the database volumes takes as long as the data is large.
TimeoutStartSec=infinity

[Install]
WantedBy=kamerplanter.target
