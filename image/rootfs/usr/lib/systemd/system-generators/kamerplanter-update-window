#!/usr/bin/bash
# Sets the start of the maintenance window from UPDATE_WINDOW (HH:MM, local
# time) in the defaults and the user's file, later wins. Runs at boot and on
# `systemctl daemon-reload`. An invalid value falls back to the default; the
# configuration check (kamerplanter-config.service) reports it.
set -euo pipefail
dir=${1:?usage: kamerplanter-update-window <normal-dir> [...]}
default=03:00
value=$(cat /usr/share/kamerplanter/kamerplanter.env /etc/kamerplanter/kamerplanter.env 2>/dev/null |
    sed -n 's/^[[:space:]]*UPDATE_WINDOW=//p' | tail -n1 | tr -d '\r')
[[ $value =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]] || value=$default
mkdir -p "$dir/kamerplanter-update-apply.timer.d"
printf '[Timer]\nOnCalendar=*-*-* %s:00\n' "$value" >"$dir/kamerplanter-update-apply.timer.d/50-window.conf"
