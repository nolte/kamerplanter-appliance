#!/usr/bin/bash
# Sets the start of the maintenance window from UPDATE_WINDOW (HH:MM, local
# time) in the defaults and the user's file, later wins. Runs at boot and on
# `systemctl daemon-reload`. A missing file or an invalid value falls back to
# the default, so the timer always has a window; the configuration check
# (kamerplanter-config.service) reports an invalid value.
set -euo pipefail
dir=${1:?usage: kamerplanter-update-window <normal-dir> [...]}
default=03:00
# shellcheck source=image/rootfs/usr/lib/kamerplanter/env.sh
. /usr/lib/kamerplanter/env.sh
load /usr/share/kamerplanter/kamerplanter.env /etc/kamerplanter/kamerplanter.env
value=$(get UPDATE_WINDOW)
[[ $value =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]] || value=$default
mkdir -p "$dir/kamerplanter-update-apply.timer.d"
printf '[Timer]\nOnCalendar=*-*-* %s:00\n' "$value" >"$dir/kamerplanter-update-apply.timer.d/50-window.conf"
