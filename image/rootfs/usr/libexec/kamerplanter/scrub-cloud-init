#!/usr/bin/bash
# Deletes the copies of the provisioning data that cloud-init keeps, and the
# provisioned secrets in its files and logs (spec/distribution-requirements/
# L15). Run by kamerplanter-cloud-init-scrub.service on every boot, after the
# provisioning step (/usr/libexec/kamerplanter/provisioning) has renewed the
# provisioning layer and staged the secrets, and after cloud-init's last stage.
# cloud-init stores the user-data again on every boot while its source stays
# attached, so this runs on every boot; a boot without provisioning data finds
# nothing to delete.
#
# Deleted, in every instance directory under /var/lib/cloud/instances/, as
# cloud-init 26.2 names them (cloudinit/helpers.py, Paths.lookups):
#   user-data.txt      the user-data as the source supplied it
#   user-data.txt.i    the user-data as cloud-init processed it
#   cloud-config.txt   the cloud-config part of the user-data
#   obj.pkl            the pickled datasource, user-data included
# and in /run/cloud-init/:
#   combined-cloud-config.json     the cloud-config combined from the image's
#                                  configuration, vendor-data and user-data
#   instance-data-sensitive.json   the instance data with the user-data
# cloud-init reads obj.pkl again in its later stages of the same boot
# (stages.py, fetch with existing="trust"), hence the order after
# cloud-final.service. On the next boot its local stage finds no cache and
# reads the source anew, as on the first boot; a boot without a source does
# not run cloud-init at all (ds-identify).
#
# Kept: cloud-init's record of the instance it has set up, which decides
# whether once-per-instance steps run again (stages.py, Init.is_new_instance
# compares the datasource's instance id with data/instance-id; the modules
# record their runs in instances/<id>/sem/), the instance link, the network
# configuration, vendor-data, status and result. None of them is a copy of the
# user-data. The seed files in /var/lib/cloud/seed/ are the source itself, not
# a copy (L3): with them cloud-init would find no provisioning data on the
# next boot and the provisioning layer would be renewed without the settings.
# They are left alone; when they hold a provisioned secret, this says so, and
# the documentation asks to delete them after the first boot (L20).
#
# The provisioned secrets are searched for, as values, in everything under
# /var/lib/cloud (the seed files apart) and /run/cloud-init, and in
# cloud-init's logs /var/log/cloud-init*.log, rotated ones included
# (cloud-init*.log*), and every occurrence is replaced by "REDACTED" in place:
# the values of kamerplanter: -> secrets:, and those of the secret keys under
# kamerplanter: -> settings: (L11). They are learned from this boot's combined
# cloud-config and from every copy of the user-data that cloud-init keeps per
# instance: cloud-config.txt (YAML), user-data.txt.i (MIME, its
# text/cloud-config parts) and user-data.txt (as the source supplied it:
# #cloud-config, MIME or gzip), all read before anything is deleted. A copy
# that holds no cloud-config, such as a shell script, is read with nothing
# learned; one that holds what is not read here, such as a Jinja template or
# an #include, counts as a copy that cannot be read. The copies are deleted last: a boot that ends before the scrub is
# through leaves them, and a later boot learns the values from them even when
# the source is gone by then and cloud-init does not run (#30, #46).
#
# When an instance has copies but none of them can be read, its secrets are
# not known. Then cloud-init's logs are deleted instead, rotated ones
# included, and every error message in cloud-init's status and result
# (/var/lib/cloud/data/{status,result}.json, and the regular files of the
# same names in /run/cloud-init) is replaced by "REDACTED": an error message
# can quote the cloud-config. The files stay JSON with their stages, times
# and number of errors, so that `cloud-init status` and cloud-init's record
# of the instance are kept; one that is not JSON is left alone and named.
#
# A compressed log (gzip, xz, bzip2) is not rewritten but deleted when it
# holds a value; one that cannot be read is deleted. Whether the image rotates
# cloud-init's logs at all is measured by the boot test (run9-logrotate); the
# scrub covers rotated logs either way. A value that spans lines is searched
# for line by line. A value or line shorter than min_secret characters is not
# searched for: replacing it would garble the logs; its key is named. A file
# that still holds a value afterwards is named and the unit fails.
#
# Nothing is followed: only regular files are deleted or rewritten, found
# without following symbolic links and without leaving the file system of the
# directory they are found in; a directory that is a symbolic link is not
# entered. Values are never printed, passed on a command line or written to
# a file of their own: they go from jq to Python through pipes only.
set -euo pipefail
umask 077

cloud_lib=/var/lib/cloud/
cloud_run=/run/cloud-init/
cloud_log=/var/log/
combined=${cloud_run}combined-cloud-config.json
min_secret=8
user_data_copies=(user-data.txt user-data.txt.i cloud-config.txt obj.pkl)
# The copies the provisioned secrets are learned from.
config_names=(cloud-config.txt user-data.txt.i user-data.txt)
# cloud-init's status and result, whose error messages can quote the
# cloud-config.
status_names=(status.json result.json)
run_copies=(combined-cloud-config.json instance-data-sensitive.json)

# shellcheck source=image/rootfs/usr/lib/kamerplanter/env.sh
. /usr/lib/kamerplanter/env.sh

# own_dir DIR: whether DIR is a directory of its own, not a symbolic link;
# says so when it is something else.
own_dir() {
    if [ -L "${1%/}" ]; then
        echo "${1%/} is a symbolic link; it is not scrubbed" >&2
        return 1
    fi
    [ -d "$1" ]
}

# secret_pairs: the provisioned secrets of the cloud-config on stdin, as JSON,
# as NUL-separated pairs KEY, VALUE; nothing when there is none or it cannot
# be read. jq's messages are dropped: they could quote the input. A NUL in a
# key or value would shift every later pair, so a value would be named as a
# key in the journal and never searched for: in a key it becomes "?" (no KEY
# name), in a value a line break (each part is searched for on its own).
secret_pairs() {
    jq -j --args '
        def pair: select((.value | type) == "string" or (.value | type) == "number")
            | (.key | gsub("\u0000"; "?")), (.value | tostring | gsub("\u0000"; "\n"));
        (.kamerplanter // {}) as $kp
        | select(($kp | type) == "object")
        | ((($kp.secrets // {}) | select(type == "object") | to_entries[] | pair),
           (($kp.settings // {}) | select(type == "object") | to_entries[]
                | select(.key as $k | $ARGS.positional | index($k)) | pair))
        | . + "\u0000"' "${provisionable_secret_keys[@]}" 2>/dev/null || true
}

# config_copies: the copies of the user-data that cloud-init keeps per
# instance and the secrets are learned from (config_names), NUL-separated.
config_copies() {
    local args=() name
    own_dir "$cloud_lib" && own_dir "${cloud_lib}instances" || return 0
    for name in "${config_names[@]}"; do args+=(-o -name "$name"); done
    find "${cloud_lib}instances" -xdev -mindepth 2 -maxdepth 2 -type f \( "${args[@]:1}" \) -print0
}

# as_json FILE: the cloud-config documents in FILE, a copy of the user-data,
# as JSON, one mapping per line, every scalar as text (BaseLoader), so a date
# or a tag that JSON does not know reads all the same. cloud-config.txt is
# read whole as YAML, whatever its first line. Of user-data.txt and
# user-data.txt.i, a gzip copy is decompressed; a copy whose first line is
# #cloud-config is one document; a MIME message gives one for each of its
# text/cloud-config parts; a shell script, a boothook, a part handler or an
# empty copy gives none. A document that is not a mapping gives none. Fails
# when FILE cannot be read, is not a regular file, or holds anything else: a
# Jinja template, an #include, a cloud-config archive or patch, a MIME message
# with a defect or a part of another type, or a cloud-config that cannot be
# read. The values in such a copy are not known from it. Nothing of it is
# printed on an error.
as_json() {
    python3 -I -c '
import email, gzip, json, os, stat, sys
import yaml
# MIME parts and first lines that hold no cloud-config.
plain_types = {"text/x-shellscript", "text/cloud-boothook", "text/part-handler",
               "text/x-shellscript-per-boot", "text/x-shellscript-per-instance",
               "text/x-shellscript-per-once"}
plain_starts = (b"#!", b"#cloud-boothook", b"#part-handler")
def load(data):
    doc = yaml.load(data, Loader=yaml.BaseLoader)
    return [doc] if isinstance(doc, dict) else []
try:
    path = sys.argv[1]
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd, "rb") as f:
        if not stat.S_ISREG(os.fstat(f.fileno()).st_mode):
            raise ValueError
        data = f.read()
    docs = []
    if os.path.basename(path) == "cloud-config.txt":
        docs = load(data)
    else:
        if data.startswith(b"\x1f\x8b"):
            data = gzip.decompress(data)
        first = data.partition(b"\n")[0].strip().lower()
        if first == b"#cloud-config":
            docs = load(data)
        elif first.startswith((b"content-type:", b"mime-version:")):
            msg = email.message_from_bytes(data)
            for part in msg.walk():
                if part.defects:
                    raise ValueError
                if part.is_multipart():
                    continue
                ctype = part.get_content_type()
                if ctype == "text/cloud-config":
                    payload = part.get_payload(decode=True)
                    if not isinstance(payload, bytes):
                        raise ValueError
                    docs += load(payload)
                elif ctype not in plain_types:
                    raise ValueError
        elif data.strip() and not first.startswith(plain_starts):
            raise ValueError
    for doc in docs:
        sys.stdout.write(json.dumps(doc) + "\n")
except Exception:
    sys.exit(1)
' "$1" 2>/dev/null
}

# values: the provisioned secrets of this boot's combined cloud-config and of
# every copy of the user-data, as NUL-separated pairs KEY, VALUE.
values() {
    local f json
    if [ -f "$combined" ] && [ ! -L "$combined" ]; then secret_pairs <"$combined"; fi
    while IFS= read -r -d '' f; do
        json=$(as_json "$f") || continue
        [ -z "$json" ] || printf '%s\n' "$json" | secret_pairs
    done < <(config_copies)
}

# unknown_instances: the instance directories whose provisioned secrets are
# not known, NUL-separated: those with a copy of the user-data none of which
# can be read (as_json). Where cloud-config.txt is there but cannot be read,
# a copy of the user-data counts only when it gives a cloud-config: one that
# gives none, such as a shell script, says nothing about what cloud-config.txt
# holds.
unknown_instances() {
    local f dir json
    local -A seen=() known=()
    while IFS= read -r -d '' f; do
        dir=${f%/*}
        seen[$dir]=1
        [ -z "${known[$dir]:-}" ] || continue
        json=$(as_json "$f") || continue
        if [ "${f##*/}" = cloud-config.txt ] || [ -n "$json" ] || { [ ! -e "$dir/cloud-config.txt" ] && [ ! -L "$dir/cloud-config.txt" ]; }; then
            known[$dir]=1
        fi
    done < <(config_copies)
    for dir in "${!seen[@]}"; do
        if [ -z "${known[$dir]:-}" ]; then printf '%s\0' "$dir"; fi
    done | sort -z
}

# status_files: cloud-init's status and result, NUL-separated: the regular
# files of status_names in /var/lib/cloud/data and in /run/cloud-init.
status_files() {
    local name f
    if own_dir "$cloud_lib" && own_dir "${cloud_lib}data"; then
        for name in "${status_names[@]}"; do
            f=${cloud_lib}data/$name
            if [ -f "$f" ] && [ ! -L "$f" ]; then printf '%s\0' "$f"; fi
        done
    fi
    if own_dir "$cloud_run"; then
        for name in "${status_names[@]}"; do
            f=$cloud_run$name
            if [ -f "$f" ] && [ ! -L "$f" ]; then printf '%s\0' "$f"; fi
        done
    fi
}

# patterns: the strings to search for, NUL-separated, longest first, from the
# pairs of values: each line of a value, and the same as it stands inside a
# JSON text when that differs. Names a key whose value is not searched for.
patterns() {
    local pairs key value line escaped
    local -A seen=()
    mapfile -d '' pairs < <(values)
    local i
    for ((i = 0; i + 1 < ${#pairs[@]}; i += 2)); do
        key=${pairs[i]}
        value=${pairs[i + 1]}
        # Shown in the journal: a key that is no KEY name may hold anything.
        [[ $key =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || key="a key that is no KEY name"
        while IFS= read -r line || [ -n "$line" ]; do
            if [ "${#line}" -lt "$min_secret" ]; then
                [ -z "$line" ] || echo "the provisioned value of $key, or a line of it, is shorter than $min_secret characters; it is not searched for in cloud-init's files and logs" >&2
                continue
            fi
            seen[$line]=1
            escaped=$(printf '%s' "$line" | jq -Rrs 'tojson | .[1:-1]')
            seen[$escaped]=1
        done < <(printf '%s\n' "$value")
    done
    for line in "${!seen[@]}"; do printf '%s\t%s\0' "${#line}" "$line"; done |
        sort -z -t $'\t' -k1,1nr | while IFS= read -r -d '' line; do printf '%s\0' "${line#*$'\t'}"; done
}

# Python, shared by redact, holds and blank_errors: read(path, log) reads the
# file at path without following a link and returns (stat, data, kind). Only
# for one of cloud-init's logs (log true) is a compressed file decompressed:
# kind names the compression, and data is None when it cannot be
# decompressed. NotAFile is raised for a link or anything but a regular file;
# any other OSError is a file that cannot be read. write(path, st, data)
# replaces the file at path by data, durably, with the owner and mode of st,
# through a new file in the same directory renamed over it.
read_file='
import bz2, errno, gzip, lzma, os, stat, sys, tempfile
class NotAFile(Exception):
    pass
def sync_dir(d):
    dfd = os.open(d, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(dfd)
    finally:
        os.close(dfd)
def write(path, st, data):
    d = os.path.dirname(path) or "."
    tfd, tmp = tempfile.mkstemp(dir=d, prefix="." + os.path.basename(path) + ".")
    try:
        with os.fdopen(tfd, "wb") as t:
            t.write(data)
            t.flush()
            os.fchown(t.fileno(), st.st_uid, st.st_gid)
            os.fchmod(t.fileno(), stat.S_IMODE(st.st_mode))
            os.fsync(t.fileno())
        os.rename(tmp, path)
    except BaseException:
        os.unlink(tmp)
        raise
    sync_dir(d)
def read(path, log):
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    except OSError as e:
        if e.errno == errno.ELOOP:
            raise NotAFile(path)
        raise
    with os.fdopen(fd, "rb") as f:
        st = os.fstat(f.fileno())
        if not stat.S_ISREG(st.st_mode):
            raise NotAFile(path)
        data = f.read()
    if not log:
        return st, data, None
    for magic, kind, open_ in ((b"\x1f\x8b", "gzip", gzip.decompress),
                               (b"\xfd7zXZ\x00", "xz", lzma.decompress),
                               (b"BZh", "bzip2", bz2.decompress),
                               (b"\x28\xb5\x2f\xfd", "zstd", None)):
        if data.startswith(magic):
            try:
                return st, open_(data) if open_ else None, kind
            except Exception:
                return st, None, kind
    return st, data, None
'

# redact FILE [log]: replaces every pattern (NUL-separated on stdin) in FILE
# by REDACTED, in place and durably, keeping its owner and mode. With log, a
# compressed FILE is deleted instead when it holds a pattern or cannot be
# decompressed. Exit status 0 when it changed FILE, 5 when it deleted it, 3
# when FILE holds none, 4 when FILE is no regular file or a symbolic link, 1
# when it cannot be read or on another error.
redact() {
    python3 -I -c "$read_file"'
path = sys.argv[1]
patterns = [p for p in sys.stdin.buffer.read().split(b"\0") if p]
try:
    st, data, kind = read(path, sys.argv[2:] == ["log"])
except NotAFile:
    sys.exit(4)
except OSError:
    sys.exit(1)
if kind:
    if data is not None and not any(p in data for p in patterns):
        sys.exit(3)
    os.unlink(path)
    sync_dir(os.path.dirname(path) or ".")
    sys.exit(5)
new = data
for p in patterns:
    new = new.replace(p, b"REDACTED")
if new == data:
    sys.exit(3)
write(path, st, new)
' "$@"
}

# blank_errors FILE: replaces every error message in FILE, cloud-init's
# status or result, by REDACTED, in place and durably, keeping its owner and
# mode: the strings in v1.errors and v1.recoverable_errors.<level> (result)
# and in the same of each stage under v1 (status). Everything else is kept,
# the number of errors too. Exit status 0 when it changed FILE, 3 when FILE
# holds no error message, 4 when FILE is no regular file or a symbolic link,
# 6 when it is not JSON, 1 when it cannot be read or on another error. Nothing
# of FILE is printed.
blank_errors() {
    python3 -I -c "$read_file"'
import json
path = sys.argv[1]
try:
    st, data, kind = read(path, False)
except NotAFile:
    sys.exit(4)
except OSError:
    sys.exit(1)
try:
    doc = json.loads(data)
except Exception:
    sys.exit(6)
changed = False
def blank(messages):
    global changed
    if not isinstance(messages, list):
        return messages
    for i, m in enumerate(messages):
        if isinstance(m, str) and m != "REDACTED":
            messages[i] = "REDACTED"
            changed = True
    return messages
def stage(s):
    if not isinstance(s, dict):
        return
    if "errors" in s:
        blank(s["errors"])
    levels = s.get("recoverable_errors")
    if isinstance(levels, dict):
        for messages in levels.values():
            blank(messages)
v1 = doc.get("v1") if isinstance(doc, dict) else None
if isinstance(v1, dict):
    stage(v1)
    for s in v1.values():
        stage(s)
if not changed:
    sys.exit(3)
write(path, st, (json.dumps(doc, indent=1, separators=(",", ": "), ensure_ascii=True) + "\n").encode())
' "$1" 2>/dev/null
}

# holds FILE [log]: whether FILE holds a pattern (NUL-separated on stdin). A
# file that cannot be read counts as holding one, and so, with log, does a
# compressed one that cannot be decompressed.
holds() {
    python3 -I -c "$read_file"'
patterns = [p for p in sys.stdin.buffer.read().split(b"\0") if p]
try:
    st, data, kind = read(sys.argv[1], sys.argv[2:] == ["log"])
except NotAFile:
    sys.exit(1)
except OSError:
    sys.exit(0)
sys.exit(0 if data is None or any(p in data for p in patterns) else 1)
' "$@"
}

# scanned: the files the provisioned secrets are searched for in,
# NUL-separated: the regular files under /var/lib/cloud but its seed files,
# under /run/cloud-init, and cloud-init's logs, rotated ones included.
scanned() {
    if own_dir "$cloud_lib"; then
        find "$cloud_lib" -xdev -path "${cloud_lib}seed" -prune -o -type f -print0
    fi
    if own_dir "$cloud_run"; then
        find "$cloud_run" -xdev -type f -print0
    fi
    if own_dir "$cloud_log"; then
        logs
    fi
}

# logs: cloud-init's logs, rotated ones included, NUL-separated.
logs() {
    find "$cloud_log" -xdev -mindepth 1 -maxdepth 1 -type f -name 'cloud-init*.log*' -print0
}

# log_kind FILE: "log" when FILE is one of cloud-init's logs, so that a
# compressed one is decompressed; empty for any other file.
log_kind() {
    local name=${1##*/}
    [ "${1%/*}/" = "$cloud_log" ] && [[ $name == cloud-init*.log* ]] && echo log || true
}

# delete_copies: deletes the copies of the user-data, and prints how many.
delete_copies() {
    local args=() name f count=0
    for name in "${user_data_copies[@]}"; do args+=(-o -name "$name"); done
    if own_dir "$cloud_lib" && own_dir "${cloud_lib}instances"; then
        while IFS= read -r -d '' f; do
            rm -f -- "$f"
            count=$((count + 1))
        done < <(find "${cloud_lib}instances" -xdev -mindepth 2 -maxdepth 2 -type f \( "${args[@]:1}" \) -print0)
    fi
    if own_dir "$cloud_run"; then
        for name in "${run_copies[@]}"; do
            f=$cloud_run$name
            if [ -f "$f" ] && [ ! -L "$f" ]; then
                rm -f -- "$f"
                count=$((count + 1))
            fi
        done
    fi
    printf '%s' "$count"
}

main() {
    local pats=() unknown=() f rc redacted=0 dropped=0 left=() unwritten=() seeded=() deleted
    # Without the YAML module that cloud-init itself uses, every copy would
    # count as unreadable and the logs would go on every boot: fail instead.
    if [ -n "$(config_copies | head -c1)" ] && ! python3 -I -c 'import yaml' 2>/dev/null; then
        echo "Python has no YAML module; cloud-init's copies of the cloud-config cannot be read, nothing is scrubbed" >&2
        return 1
    fi
    # Read before anything is deleted: the copies are deleted last, so that a
    # boot that ends before this is through can learn the values again.
    mapfile -d '' pats < <(patterns)
    mapfile -d '' unknown < <(unknown_instances)
    if [ "${#unknown[@]}" -gt 0 ]; then
        for f in "${unknown[@]}"; do
            echo "$f: no copy of the cloud-config can be read; the provisioned secrets in it are not known, so cloud-init's logs are deleted and the error messages in its status are replaced" >&2
        done
        if own_dir "$cloud_log"; then
            while IFS= read -r -d '' f; do
                rm -f -- "$f"
                echo "deleted $f"
            done < <(logs)
        fi
        while IFS= read -r -d '' f; do
            rc=0
            blank_errors "$f" || rc=$?
            case $rc in
                0)
                    ! command -v restorecon >/dev/null || restorecon -F -- "$f" 2>/dev/null || true
                    echo "error messages replaced in $f"
                    ;;
                6) echo "$f is not JSON; its error messages are left as they are" >&2 ;;
                3 | 4) ;;
                *) unwritten+=("$f") ;;
            esac
        done < <(status_files)
    fi
    if [ "${#pats[@]}" -gt 0 ]; then
        while IFS= read -r -d '' f; do
            rc=0
            # shellcheck disable=SC2046 # empty or one word
            printf '%s\0' "${pats[@]}" | redact "$f" $(log_kind "$f") || rc=$?
            case $rc in
                0)
                    redacted=$((redacted + 1))
                    # The rewritten file takes the label of its directory;
                    # give it back its own, such as that of cloud-init's log.
                    ! command -v restorecon >/dev/null || restorecon -F -- "$f" 2>/dev/null || true
                    echo "provisioned secrets replaced in $f"
                    ;;
                5)
                    dropped=$((dropped + 1))
                    echo "deleted $f: a compressed file that holds provisioned secrets or cannot be read"
                    ;;
                3 | 4) ;;
                *) left+=("$f") ;;
            esac
        done < <(scanned)
        while IFS= read -r -d '' f; do
            # shellcheck disable=SC2046 # empty or one word
            if printf '%s\0' "${pats[@]}" | holds "$f" $(log_kind "$f"); then left+=("$f"); fi
        done < <(scanned)
        if own_dir "$cloud_lib" && own_dir "${cloud_lib}seed"; then
            while IFS= read -r -d '' f; do
                if printf '%s\0' "${pats[@]}" | holds "$f"; then seeded+=("$f"); fi
            done < <(find "${cloud_lib}seed" -xdev -type f -print0)
        fi
    fi
    # A file that still holds a value, or whose error messages could not be
    # replaced, keeps the copies, so that the next boot can learn the values
    # again, or find them unknown again, and retry.
    if [ "${#left[@]}" -eq 0 ] && [ "${#unwritten[@]}" -eq 0 ]; then deleted=$(delete_copies); else deleted=0; fi
    echo "cloud-init's copies of the provisioning data deleted: $deleted; files with provisioned secrets replaced: $redacted"
    [ "$dropped" = 0 ] || echo "compressed logs with provisioned secrets deleted: $dropped"
    for f in "${seeded[@]}"; do
        echo "warning: the seed file $f holds provisioned secrets in plain text; once the appliance has started, delete the seed files and the configuration file that names them (it keeps its settings without them)" >&2
    done
    if [ "${#left[@]}" -gt 0 ] || [ "${#unwritten[@]}" -gt 0 ]; then
        for f in "${left[@]}"; do echo "$f still holds provisioned secrets" >&2; done
        for f in "${unwritten[@]}"; do echo "$f cannot be rewritten; its error messages are not replaced" >&2; done
        echo "cloud-init's copies of the provisioning data are kept until the next boot retries" >&2
        return 1
    fi
}

main
