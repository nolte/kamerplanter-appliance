#!/usr/bin/bash
# Deletes the copies of the provisioning data that cloud-init keeps, and the
# provisioned secrets in its files and logs (spec/distribution-requirements/
# L15). Run by kamerplanter-cloud-init-scrub.service on every boot, after the
# provisioning step (/usr/libexec/kamerplanter/provisioning) has renewed the
# provisioning layer and staged the secrets, and after cloud-init's last stage.
# cloud-init stores the user-data again on every boot while its source stays
# attached, so this runs on every boot; a boot without provisioning data finds
# nothing to delete.
#
# Deleted, in every instance directory under /var/lib/cloud/instances/, as
# cloud-init 26.2 names them (cloudinit/helpers.py, Paths.lookups):
#   user-data.txt      the user-data as the source supplied it
#   user-data.txt.i    the user-data as cloud-init processed it
#   cloud-config.txt   the cloud-config part of the user-data
#   obj.pkl            the pickled datasource, user-data included
# and in /run/cloud-init/:
#   combined-cloud-config.json     the cloud-config combined from the image's
#                                  configuration, vendor-data and user-data
#   instance-data-sensitive.json   the instance data with the user-data
# cloud-init reads obj.pkl again in its later stages of the same boot
# (stages.py, fetch with existing="trust"), hence the order after
# cloud-final.service. On the next boot its local stage finds no cache and
# reads the source anew, as on the first boot; a boot without a source does
# not run cloud-init at all (ds-identify).
#
# Kept: cloud-init's record of the instance it has set up, which decides
# whether once-per-instance steps run again (stages.py, Init.is_new_instance
# compares the datasource's instance id with data/instance-id; the modules
# record their runs in instances/<id>/sem/), the instance link, the network
# configuration, vendor-data, status and result. None of them is a copy of the
# user-data. The seed files in /var/lib/cloud/seed/ are the source itself, not
# a copy (L3): with them cloud-init would find no provisioning data on the
# next boot and the provisioning layer would be renewed without the settings.
# They are left alone; when they hold a provisioned secret, this says so, and
# the documentation asks to delete them after the first boot (L20).
#
# The provisioned secrets are searched for, as values, in everything under
# /var/lib/cloud (the seed files apart) and /run/cloud-init but the copies
# that are deleted, which keep their values until then (#76), and in
# cloud-init's logs /var/log/cloud-init*.log, rotated ones included
# (cloud-init*.log*), and every occurrence is replaced by "REDACTED" in place:
# the values of kamerplanter: -> secrets:, and those of the secret keys under
# kamerplanter: -> settings: (L11). Each is searched for as it stands, inside
# a JSON text, and in the forms Python prints it in: inside its repr or
# ascii, the repr of its UTF-8 bytes and json.dumps, with an apostrophe both
# bare and escaped, and each of those as it stands inside a JSON text, as in
# an error message in cloud-init's status. They are learned from this boot's
# combined cloud-config and from every copy of the user-data that cloud-init
# keeps per instance: cloud-config.txt (YAML), user-data.txt.i (MIME, its
# text/cloud-config parts) and user-data.txt (as the source supplied it:
# #cloud-config, MIME or gzip), all read before anything is deleted. A copy
# that holds no cloud-config, such as a shell script, is read with nothing
# learned; one that holds what is not read here, such as a Jinja template or
# an #include, counts as a copy that cannot be read. Each copy is read once,
# for its values and for whether it can be read (#76). The copies are deleted
# last: a boot that ends before the scrub is through leaves them, and a later
# boot learns the values from them even when the source is gone by then and
# cloud-init does not run (#30, #46). Of an instance's copies, those that
# could be read go last: what a boot that ends in between leaves is not an
# instance whose secrets are unknown (#120).
#
# The copies are kept, and the unit fails, whenever the scrub is not through
# (#76): when jq cannot run or fails on the combined cloud-config or on a
# copy, so that the values in it are not known (without jq none are, and
# nothing is scrubbed, as without Python's YAML module); when jq or Python
# fails to make the values into their forms, or Python makes none, so that
# none is searched for; and when there is something to scrub and /var/log is
# a symbolic link, which is not entered, or one of cloud-init's logs is, which
# is not rewritten through it, or /var/lib/cloud/data or the status or result
# in it is, which are not scrubbed through it; and whenever /var/lib/cloud,
# its instances/, an instance directory in it, /run/cloud-init or a copy is a
# symbolic link, behind which copies could lie unread (#93). Each such link is
# named once. So when the logs go (see below) and the file system of
# /var/lib/cloud/data is another or cannot be told: the status and result in
# it are not rewritten, and their error messages stay as they are on every
# such boot, while the logs are deleted and the unit fails all the same. That
# is decided (#173): they are not replaced through an open of their own that
# follows no link, since no search enters that directory and nothing else in
# it is rewritten either. The next boot retries. A copy that cannot be deleted
# is named, and the unit fails, and so does a log that cannot be deleted when
# it is to be (see below). The services do not wait for the scrub, and the
# update's health check does not look at it: a failed scrub stops nothing.
#
# When an instance has copies but none of them can be read, its secrets are
# not known; so when it holds only an obj.pkl, which is not read here, or
# only copies that are not read (#120). Then cloud-init's logs are deleted
# instead, rotated ones included, and every error message in cloud-init's
# status and result (/var/lib/cloud/data/{status,result}.json, and the
# regular files of the same names in /run/cloud-init) is replaced by
# "REDACTED": an error message can quote the cloud-config. The files stay
# JSON with their stages, times and number of errors, so that
# `cloud-init status` and cloud-init's record of the instance are kept; one
# that is not JSON is left alone and named.
#
# A compressed log (gzip, xz, bzip2) is not rewritten but deleted when it
# holds a value; one that cannot be read is deleted. Whether the image rotates
# cloud-init's logs at all is measured by the boot test (run9-logrotate); the
# scrub covers rotated logs either way. A value that spans lines is searched
# for line by line. A value or line shorter than min_secret characters is not
# searched for: replacing it would garble the logs; its key is named. A file
# that still holds a value afterwards is named and the unit fails.
#
# Nothing is followed: only regular files are deleted or rewritten, found
# without following symbolic links and without leaving the file system of the
# directory they are found in; a directory that is a symbolic link is not
# entered, and a link in a place that matters is named (see above). A
# directory on another file system is not entered either, and a search that
# fails has passed over what it could not read: neither is taken for an empty
# place (#119). An instance directory on another file system keeps the copies
# and fails the unit, like a link in its place; any other directory on another
# file system under /var/lib/cloud (the seed files apart) or /run/cloud-init
# does when there is something to scrub, and is only named otherwise; the
# status and result in a /var/lib/cloud/data on another file system are not
# rewritten. A search that fails (find's exit status; find names what it could
# not read, each time it meets it) always does, and its place is named once: a
# place within one that is named is not named again, and a place around one
# only when its search fails outside the named one as well, which is another
# cause (#173). A directory whose file system cannot be told (stat fails on
# it, and it is still there) always does as well, the seed files apart, and
# is named once, as that and not as a search that failed (#170). A file that
# is gone by the time find looks at it is no failure, nor is a directory that
# is gone when its file system is asked for. Values are never printed, passed
# on a command line or written to a file of their own: they go from jq to
# Python through pipes only.
set -euo pipefail
umask 077

cloud_lib=/var/lib/cloud/
cloud_run=/run/cloud-init/
cloud_log=/var/log/
combined=${cloud_run}combined-cloud-config.json
min_secret=8
user_data_copies=(user-data.txt user-data.txt.i cloud-config.txt obj.pkl)
# The copies the provisioned secrets are learned from.
config_names=(cloud-config.txt user-data.txt.i user-data.txt)
# cloud-init's status and result, whose error messages can quote the
# cloud-config.
status_names=(status.json result.json)
run_copies=(combined-cloud-config.json instance-data-sensitive.json)

# shellcheck source=image/rootfs/usr/lib/kamerplanter/env.sh
. /usr/lib/kamerplanter/env.sh

# own_dir DIR: whether DIR is a directory of its own, not a symbolic link.
# Says nothing: it is asked several times per run, in subshells too, and main
# names each place that is a link once (#93).
own_dir() {
    [ ! -L "${1%/}" ] && [ -d "$1" ]
}

# secret_pairs: the provisioned secrets of the cloud-config on stdin, as JSON,
# as NUL-separated pairs KEY, VALUE; nothing when there is none. Fails when jq
# fails, such as on input that is not JSON: then the secrets in it are not
# known. jq's messages are dropped: they could quote the input. A NUL in a
# key or value would shift every later pair, so a value would be named as a
# key in the journal and never searched for: in a key it becomes "?" (no KEY
# name), in a value a line break (each part is searched for on its own).
secret_pairs() {
    jq -j --args '
        def pair: select((.value | type) == "string" or (.value | type) == "number")
            | (.key | gsub("\u0000"; "?")), (.value | tostring | gsub("\u0000"; "\n"));
        (.kamerplanter // {}) as $kp
        | select(($kp | type) == "object")
        | ((($kp.secrets // {}) | select(type == "object") | to_entries[] | pair),
           (($kp.settings // {}) | select(type == "object") | to_entries[]
                | select(.key as $k | $ARGS.positional | index($k)) | pair))
        | . + "\u0000"' "${provisionable_secret_keys[@]}" 2>/dev/null
}

# take_pairs: adds the pairs of secret_pairs, of the cloud-config on stdin,
# to pairs; fails, adding none, when secret_pairs fails. The pairs go from jq
# through a pipe into memory, never into a file.
take_pairs() {
    local got=() rc=0
    mapfile -d '' -t got < <(secret_pairs)
    wait "$!" || rc=$?
    [ "$rc" = 0 ] || return 1
    pairs+=("${got[@]}")
}

# list NAME COMMAND... (reads the NUL-separated output of COMMAND into the
# array NAME, and fails when COMMAND fails) is in
# /usr/lib/kamerplanter/env.sh: every search (find) here is read through it,
# so that a place it could not read does not pass for an empty one (#119).

# instance_copies: the copies of the user-data that cloud-init keeps per
# instance (user_data_copies), NUL-separated: the ones delete_copies deletes.
# The secrets are learned from those of config_names (is_config). Fails when
# the search fails.
instance_copies() {
    local args=() name
    own_dir "$cloud_lib" && own_dir "${cloud_lib}instances" || return 0
    for name in "${user_data_copies[@]}"; do args+=(-o -name "$name"); done
    find "${cloud_lib}instances" -ignore_readdir_race -xdev -mindepth 2 -maxdepth 2 -type f \( "${args[@]:1}" \) -print0
}
is_config() {
    local name
    for name in "${config_names[@]}"; do [ "${1##*/}" != "$name" ] || return 0; done
    return 1
}

# foreign START [EXPRESSION...]: the directories below START that are on
# another file system than START, NUL-separated. find -xdev lists such a
# directory and does not enter it, so nothing in it is read, rewritten or
# deleted (#119). EXPRESSION goes before the test for a directory, such as
# -maxdepth 1 or a -prune with its -o. A directory whose file system cannot
# be told (stat fails on it) is printed as well, with a "?" before its path,
# which no path here begins with; so is START, alone, when its own cannot be
# told: then no directory below it is compared. main takes those out (told)
# and names them as what they are (#170); among the seed files it only warns
# of one, as of everything there. Fails only when the search fails. A
# directory that is gone by then (gone) is on none, START too:
# -ignore_readdir_race covers find alone. START is asked for without its
# trailing slash, as it is printed: with it, a symbolic link in its place
# would be followed, and one that leads nowhere would pass for gone (#184).
foreign() {
    local start=$1 dev other d dirs=() rc=0
    shift
    if ! dev=$(stat -c %d -- "$start" 2>/dev/null); then
        gone "${start%/}" || printf '?%s\0' "${start%/}"
        return 0
    fi
    list dirs find "$start" -ignore_readdir_race -xdev -mindepth 1 "$@" -type d -print0 || rc=1
    for d in "${dirs[@]}"; do
        if other=$(stat -c %d -- "$d" 2>/dev/null); then
            [ "$other" = "$dev" ] || printf '%s\0' "$d"
        elif ! gone "$d"; then
            printf '?%s\0' "$d"
        fi
    done
    return "$rc"
}

# gone PATH: whether nothing is at PATH any more. Only "no such file" counts:
# a PATH that cannot be looked at for another reason, such as a file system
# that refuses root, is not gone.
gone() {
    python3 -I -c '
import os, sys
try:
    os.lstat(sys.argv[1])
except (FileNotFoundError, NotADirectoryError):
    sys.exit(0)
except Exception:
    pass
sys.exit(1)
' "$1" 2>/dev/null
}

# linked_instances: the symbolic links in /var/lib/cloud/instances, each in
# place of an instance directory, NUL-separated. linked_copies: the symbolic
# links in place of a copy of the provisioning data, in an instance directory
# (user_data_copies) or in /run/cloud-init (run_copies), NUL-separated.
# Neither is followed, so the copies behind them are neither read nor deleted
# (#93). linked_logs: the symbolic links in place of one of cloud-init's
# logs, NUL-separated. Each fails when its search fails.
linked_instances() {
    own_dir "$cloud_lib" && own_dir "${cloud_lib}instances" || return 0
    find "${cloud_lib}instances" -ignore_readdir_race -xdev -mindepth 1 -maxdepth 1 -type l -print0
}
linked_logs() {
    find "$cloud_log" -ignore_readdir_race -xdev -mindepth 1 -maxdepth 1 -type l -name 'cloud-init*.log*' -print0
}
linked_copies() {
    local args=() name rc=0
    if own_dir "$cloud_lib" && own_dir "${cloud_lib}instances"; then
        for name in "${user_data_copies[@]}"; do args+=(-o -name "$name"); done
        find "${cloud_lib}instances" -ignore_readdir_race -xdev -mindepth 2 -maxdepth 2 -type l \( "${args[@]:1}" \) -print0 || rc=1
    fi
    if own_dir "$cloud_run"; then
        for name in "${run_copies[@]}"; do
            if [ -L "$cloud_run$name" ]; then printf '%s\0' "$cloud_run$name"; fi
        done
    fi
    return "$rc"
}

# as_json FILE: the cloud-config documents in FILE, a copy of the user-data,
# as JSON, one mapping per line, every scalar as text (BaseLoader), so a date
# or a tag that JSON does not know reads all the same; merge keys (<<) are
# resolved, as cloud-init resolves them (SafeLoader), and a plain << that is
# no key stays text. cloud-config.txt is read whole as YAML, whatever its
# first line. Of user-data.txt and user-data.txt.i, a gzip copy is
# decompressed; a copy whose first line is #cloud-config is one document; a
# MIME message gives one for each of its text/cloud-config parts; a shell
# script, a boothook, a part handler or an empty copy gives none. A document
# that is not a mapping gives none. Fails when FILE cannot be read, is not a
# regular file, or holds anything else: a Jinja template, an #include, a
# cloud-config archive or patch, a MIME message with a defect or a part of
# another type, or a cloud-config that cannot be read. The values in such a
# copy are not known from it. Nothing of it is printed on an error.
as_json() {
    python3 -I -c '
import email, gzip, json, os, re, stat, sys
import yaml
# MIME parts and first lines that hold no cloud-config.
plain_types = {"text/x-shellscript", "text/cloud-boothook", "text/part-handler",
               "text/x-shellscript-per-boot", "text/x-shellscript-per-instance",
               "text/x-shellscript-per-once"}
plain_starts = (b"#!", b"#cloud-boothook", b"#part-handler")
# BaseLoader, with the merge keys (<<) resolved as SafeLoader resolves them.
class Loader(yaml.BaseLoader):
    flatten_mapping = yaml.constructor.SafeConstructor.flatten_mapping
    def construct_mapping(self, node, deep=False):
        if isinstance(node, yaml.MappingNode):
            self.flatten_mapping(node)
        return super().construct_mapping(node, deep=deep)
Loader.add_implicit_resolver("tag:yaml.org,2002:merge", re.compile("^(?:<<)$"), ["<"])
def load(data):
    doc = yaml.load(data, Loader=Loader)
    return [doc] if isinstance(doc, dict) else []
try:
    path = sys.argv[1]
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd, "rb") as f:
        if not stat.S_ISREG(os.fstat(f.fileno()).st_mode):
            raise ValueError
        data = f.read()
    docs = []
    if os.path.basename(path) == "cloud-config.txt":
        docs = load(data)
    else:
        if data.startswith(b"\x1f\x8b"):
            data = gzip.decompress(data)
        first = data.partition(b"\n")[0].strip().lower()
        if first == b"#cloud-config":
            docs = load(data)
        elif first.startswith((b"content-type:", b"mime-version:")):
            msg = email.message_from_bytes(data)
            for part in msg.walk():
                if part.defects:
                    raise ValueError
                if part.is_multipart():
                    continue
                ctype = part.get_content_type()
                if ctype == "text/cloud-config":
                    payload = part.get_payload(decode=True)
                    if not isinstance(payload, bytes):
                        raise ValueError
                    docs += load(payload)
                elif ctype not in plain_types:
                    raise ValueError
        elif data.strip() and not first.startswith(plain_starts):
            raise ValueError
    for doc in docs:
        sys.stdout.write(json.dumps(doc) + "\n")
except Exception:
    sys.exit(1)
' "$1" 2>/dev/null
}

# learn COPY...: reads this boot's combined cloud-config and every COPY of the
# user-data (instance_copies) the secrets are learned from (is_config), each
# once (#76), and sets
#   pairs      their provisioned secrets, as pairs KEY, VALUE;
#   unknown    the instance directories whose provisioned secrets are not
#              known: those with a copy of the user-data none of which can
#              be read (as_json), and so those with nothing but an obj.pkl,
#              which is not read at all and is deleted with the others
#              (#120). Where cloud-config.txt is there but cannot be read, a
#              copy of the user-data counts only when it gives a
#              cloud-config: one that gives none, such as a shell script,
#              says nothing about what cloud-config.txt holds;
#   unlearned  the files that can be read but whose secrets jq could not
#              take out (take_pairs);
#   readable   the copies that can be read (as_json), for delete_copies.
learn() {
    local f dir json
    local -A seen=() known=()
    pairs=() unknown=() unlearned=()
    declare -gA readable=()
    if own_dir "$cloud_run" && [ -f "$combined" ] && [ ! -L "$combined" ]; then
        take_pairs <"$combined" || unlearned+=("$combined")
    fi
    for f in "$@"; do
        dir=${f%/*}
        seen[$dir]=1
        is_config "$f" || continue
        json=$(as_json "$f") || continue
        readable[$f]=1
        if [ -n "$json" ]; then
            take_pairs < <(printf '%s\n' "$json") || unlearned+=("$f")
        fi
        if [ "${f##*/}" = cloud-config.txt ] || [ -n "$json" ] || { [ ! -e "$dir/cloud-config.txt" ] && [ ! -L "$dir/cloud-config.txt" ]; }; then
            known[$dir]=1
        fi
    done
    for dir in "${!seen[@]}"; do
        if [ -z "${known[$dir]:-}" ]; then unknown+=("$dir"); fi
    done
    if [ "${#unknown[@]}" -gt 0 ]; then mapfile -d '' -t unknown < <(printf '%s\0' "${unknown[@]}" | sort -z); fi
}

# status_files: cloud-init's status and result, NUL-separated: the regular
# files of status_names in /var/lib/cloud/data and in /run/cloud-init. Not
# those in a /var/lib/cloud/data on another file system than /var/lib/cloud:
# no search enters it (find -xdev), so nothing in it is rewritten either, and
# main names it (foreign). Exit status 3 when it is on another file system,
# 4 when its file system cannot be told, 1 when that of /var/lib/cloud cannot,
# so that the two are not compared: main names each cause by its directory
# (#184). In each case those files are not among them, and the others are. A
# /var/lib/cloud/data that is gone when its file system is asked for (gone)
# holds none and is no failure, as for foreign (#170), nor is a /var/lib/cloud
# that is gone by then (#184).
status_files() {
    local name f dev other rc=0
    if own_dir "$cloud_lib" && own_dir "${cloud_lib}data"; then
        if ! dev=$(stat -c %d -- "$cloud_lib" 2>/dev/null); then
            gone "${cloud_lib%/}" || rc=1
        elif other=$(stat -c %d -- "${cloud_lib}data" 2>/dev/null); then
            if [ "$other" = "$dev" ]; then
                for name in "${status_names[@]}"; do
                    f=${cloud_lib}data/$name
                    if [ -f "$f" ] && [ ! -L "$f" ]; then printf '%s\0' "$f"; fi
                done
            else
                rc=3
            fi
        elif ! gone "${cloud_lib}data"; then
            rc=4
        fi
    fi
    if own_dir "$cloud_run"; then
        for name in "${status_names[@]}"; do
            f=$cloud_run$name
            if [ -f "$f" ] && [ ! -L "$f" ]; then printf '%s\0' "$f"; fi
        done
    fi
    return "$rc"
}

# forms: reads lines NUL-separated on stdin and prints, NUL-separated, the
# forms in which Python prints each: inside its repr, its ascii, the repr of
# its UTF-8 bytes, and json.dumps with and without ensure_ascii. repr picks
# its quote by the whole string it is given, and a value can be printed alone
# or inside a longer string: an apostrophe is taken both bare and escaped.
# Each of the first three is given as json.dumps prints it as well: a message
# that quotes a value by its repr can itself be written as JSON.
# Fails, printing nothing, on a line that is not UTF-8 or on another error.
forms() {
    python3 -I -c '
import json, sys
def spellings(s, form):
    # A part without an apostrophe is single-quoted and escapes no quote.
    parts = [form(p) for p in s.split("\x27")]
    return {"\x27".join(parts), "\\\x27".join(parts)}
try:
    got = set()
    for raw in sys.stdin.buffer.read().split(b"\0"):
        if not raw:
            continue
        s = raw.decode("utf-8")
        quoted = spellings(s, lambda p: repr(p)[1:-1])
        quoted |= spellings(s, lambda p: ascii(p)[1:-1])
        quoted |= spellings(s, lambda p: repr(p.encode("utf-8"))[2:-1])
        for f in quoted | {s}:
            got.add(json.dumps(f)[1:-1])
            got.add(json.dumps(f, ensure_ascii=False)[1:-1])
        got |= quoted
    data = b"".join(f.encode("utf-8") + b"\0" for f in got if f)
except Exception:
    sys.exit(1)
sys.stdout.buffer.write(data)
' 2>/dev/null
}

# patterns: the strings to search for, NUL-separated, longest first, from
# pairs (learn): each line of a value, the same as it stands inside a JSON
# text (jq), and the forms Python prints it in (forms). Names a key whose
# value is not searched for. Fails, printing nothing, when jq or Python fails
# or Python makes no form.
patterns() {
    local key value line escaped i lines=() got=()
    local -A seen=()
    for ((i = 0; i + 1 < ${#pairs[@]}; i += 2)); do
        key=${pairs[i]}
        value=${pairs[i + 1]}
        # Shown in the journal: a key that is no KEY name may hold anything.
        [[ $key =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || key="a key that is no KEY name"
        while IFS= read -r line || [ -n "$line" ]; do
            if [ "${#line}" -lt "$min_secret" ]; then
                [ -z "$line" ] || echo "the provisioned value of $key, or a line of it, is shorter than $min_secret characters; it is not searched for in cloud-init's files and logs" >&2
                continue
            fi
            seen[$line]=1
            escaped=$(printf '%s' "$line" | jq -Rrs 'tojson | .[1:-1]' 2>/dev/null) || return 1
            seen[$escaped]=1
            lines+=("$line")
        done < <(printf '%s\n' "$value")
    done
    if [ "${#lines[@]}" -gt 0 ]; then
        mapfile -d '' -t got < <(printf '%s\0' "${lines[@]}" | forms)
        wait "$!" || return 1
        # Every line has a form.
        [ "${#got[@]}" -gt 0 ] || return 1
        for line in "${got[@]}"; do seen[$line]=1; done
    fi
    for line in "${!seen[@]}"; do printf '%s\t%s\0' "${#line}" "$line"; done |
        sort -z -t $'\t' -k1,1nr | while IFS= read -r -d '' line; do printf '%s\0' "${line#*$'\t'}"; done
}

# Python, shared by redact, holds and blank_errors: read(path, log) reads the
# file at path without following a link and returns (stat, data, kind). Only
# for one of cloud-init's logs (log true) is a compressed file decompressed:
# kind names the compression, and data is None when it cannot be
# decompressed. NotAFile is raised for a link or anything but a regular file;
# any other OSError is a file that cannot be read. write(path, st, data)
# replaces the file at path by data, durably, with the owner and mode of st,
# through a new file in the same directory renamed over it.
read_file='
import bz2, errno, gzip, lzma, os, stat, sys, tempfile
class NotAFile(Exception):
    pass
def sync_dir(d):
    dfd = os.open(d, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(dfd)
    finally:
        os.close(dfd)
def write(path, st, data):
    d = os.path.dirname(path) or "."
    tfd, tmp = tempfile.mkstemp(dir=d, prefix="." + os.path.basename(path) + ".")
    try:
        with os.fdopen(tfd, "wb") as t:
            t.write(data)
            t.flush()
            os.fchown(t.fileno(), st.st_uid, st.st_gid)
            os.fchmod(t.fileno(), stat.S_IMODE(st.st_mode))
            os.fsync(t.fileno())
        os.rename(tmp, path)
    except BaseException:
        os.unlink(tmp)
        raise
    sync_dir(d)
def read(path, log):
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    except OSError as e:
        if e.errno == errno.ELOOP:
            raise NotAFile(path)
        raise
    with os.fdopen(fd, "rb") as f:
        st = os.fstat(f.fileno())
        if not stat.S_ISREG(st.st_mode):
            raise NotAFile(path)
        data = f.read()
    if not log:
        return st, data, None
    for magic, kind, open_ in ((b"\x1f\x8b", "gzip", gzip.decompress),
                               (b"\xfd7zXZ\x00", "xz", lzma.decompress),
                               (b"BZh", "bzip2", bz2.decompress),
                               (b"\x28\xb5\x2f\xfd", "zstd", None)):
        if data.startswith(magic):
            try:
                return st, open_(data) if open_ else None, kind
            except Exception:
                return st, None, kind
    return st, data, None
'

# redact FILE [log]: replaces every pattern (NUL-separated on stdin) in FILE
# by REDACTED, in place and durably, keeping its owner and mode. With log, a
# compressed FILE is deleted instead when it holds a pattern or cannot be
# decompressed. Exit status 0 when it changed FILE, 5 when it deleted it, 3
# when FILE holds none, 4 when FILE is no regular file or a symbolic link, 1
# when it cannot be read or on another error.
redact() {
    python3 -I -c "$read_file"'
path = sys.argv[1]
patterns = [p for p in sys.stdin.buffer.read().split(b"\0") if p]
try:
    st, data, kind = read(path, sys.argv[2:] == ["log"])
except NotAFile:
    sys.exit(4)
except OSError:
    sys.exit(1)
if kind:
    if data is not None and not any(p in data for p in patterns):
        sys.exit(3)
    os.unlink(path)
    sync_dir(os.path.dirname(path) or ".")
    sys.exit(5)
new = data
for p in patterns:
    new = new.replace(p, b"REDACTED")
if new == data:
    sys.exit(3)
write(path, st, new)
' "$@"
}

# blank_errors FILE: replaces every error message in FILE, cloud-init's
# status or result, by REDACTED, in place and durably, keeping its owner and
# mode: the strings in v1.errors and v1.recoverable_errors.<level> (result)
# and in the same of each stage under v1 (status). Everything else is kept,
# the number of errors too. Exit status 0 when it changed FILE, 3 when FILE
# holds no error message, 4 when FILE is no regular file or a symbolic link,
# 6 when it is not JSON, 1 when it cannot be read or on another error. Nothing
# of FILE is printed.
blank_errors() {
    python3 -I -c "$read_file"'
import json
path = sys.argv[1]
try:
    st, data, kind = read(path, False)
except NotAFile:
    sys.exit(4)
except OSError:
    sys.exit(1)
try:
    doc = json.loads(data)
except Exception:
    sys.exit(6)
changed = False
def blank(messages):
    global changed
    if not isinstance(messages, list):
        return messages
    for i, m in enumerate(messages):
        if isinstance(m, str) and m != "REDACTED":
            messages[i] = "REDACTED"
            changed = True
    return messages
def stage(s):
    if not isinstance(s, dict):
        return
    if "errors" in s:
        blank(s["errors"])
    levels = s.get("recoverable_errors")
    if isinstance(levels, dict):
        for messages in levels.values():
            blank(messages)
v1 = doc.get("v1") if isinstance(doc, dict) else None
if isinstance(v1, dict):
    stage(v1)
    for s in v1.values():
        stage(s)
if not changed:
    sys.exit(3)
write(path, st, (json.dumps(doc, indent=1, separators=(",", ": "), ensure_ascii=True) + "\n").encode())
' "$1" 2>/dev/null
}

# holds FILE [log]: whether FILE holds a pattern (NUL-separated on stdin). A
# file that cannot be read counts as holding one, and so, with log, does a
# compressed one that cannot be decompressed.
holds() {
    python3 -I -c "$read_file"'
patterns = [p for p in sys.stdin.buffer.read().split(b"\0") if p]
try:
    st, data, kind = read(sys.argv[1], sys.argv[2:] == ["log"])
except NotAFile:
    sys.exit(1)
except OSError:
    sys.exit(0)
sys.exit(0 if data is None or any(p in data for p in patterns) else 1)
' "$@"
}

# scanned: the files the provisioned secrets are searched for in,
# NUL-separated: the regular files under /var/lib/cloud but its seed files,
# under /run/cloud-init, and cloud-init's logs, rotated ones included; not the
# copies that delete_copies deletes. Those are deleted when the scrub is
# through and otherwise kept as they are, values included, so that the next
# boot can learn the values from them again (#76): a copy with its values
# replaced would teach it nothing. Fails when a search fails: then not every
# file is among them (#119).
scanned() {
    local f got=() all=() rc=0
    if own_dir "$cloud_lib"; then
        list got find "$cloud_lib" -ignore_readdir_race -xdev -path "${cloud_lib}seed" -prune -o -type f -print0 || rc=1
        all+=("${got[@]}")
    fi
    if own_dir "$cloud_run"; then
        list got find "$cloud_run" -ignore_readdir_race -xdev -type f -print0 || rc=1
        all+=("${got[@]}")
    fi
    if own_dir "$cloud_log"; then
        list got logs || rc=1
        all+=("${got[@]}")
    fi
    for f in "${all[@]}"; do
        is_copy "$f" || printf '%s\0' "$f"
    done
    return "$rc"
}

# is_copy FILE: whether FILE is one of the copies that delete_copies deletes.
is_copy() {
    local name=${1##*/} dir=${1%/*} copy
    if [ "${dir%/*}/" = "${cloud_lib}instances/" ]; then
        for copy in "${user_data_copies[@]}"; do [ "$name" != "$copy" ] || return 0; done
    fi
    if [ "$dir/" = "$cloud_run" ]; then
        for copy in "${run_copies[@]}"; do [ "$name" != "$copy" ] || return 0; done
    fi
    return 1
}

# logs: cloud-init's logs, rotated ones included, NUL-separated. Fails when
# the search fails.
logs() {
    find "$cloud_log" -ignore_readdir_race -xdev -mindepth 1 -maxdepth 1 -type f -name 'cloud-init*.log*' -print0
}

# log_kind FILE: "log" when FILE is one of cloud-init's logs, so that a
# compressed one is decompressed; empty for any other file.
log_kind() {
    local name=${1##*/}
    [ "${1%/*}/" = "$cloud_log" ] && [[ $name == cloud-init*.log* ]] && echo log || true
}

# delete_copies: deletes the copies of the user-data, and prints how many.
# Names a copy that cannot be deleted and fails: the copies are not
# rewritten (scanned), so such a copy still holds the values. Fails as well
# when the search for the copies fails, and says so: then not every copy was
# found (#119).
delete_copies() {
    local name f found=() pickles=() unread=() others=() configs=() count=0 rc=0
    if ! list found instance_copies; then
        echo "${cloud_lib}instances cannot be searched (see find's message); not every copy of the provisioning data in it is deleted" >&2
        rc=1
    fi
    # The pickles first: a boot that ends in between leaves the copies the
    # secrets are learned from, not an instance with nothing but a pickle,
    # for which the next boot would delete the logs (#120). For the same
    # reason the copies that could not be read (learn) go before those that
    # could: beside a user-data.txt that is not read here, such as a Jinja
    # template or an #include, cloud-config.txt is the only copy to learn
    # from, and beside a cloud-config.txt that cannot be read, user-data.txt
    # is (#46). Of those that could be read, cloud-config.txt goes last:
    # without it, a copy of the user-data that gives no cloud-config counts
    # as all there is to know.
    for f in "${found[@]}"; do
        if [ "${f##*/}" = obj.pkl ]; then
            pickles+=("$f")
        elif [ -z "${readable[$f]:-}" ]; then
            unread+=("$f")
        elif [ "${f##*/}" = cloud-config.txt ]; then
            configs+=("$f")
        else
            others+=("$f")
        fi
    done
    for f in "${pickles[@]}" "${unread[@]}" "${others[@]}" "${configs[@]}"; do
        if rm -f -- "$f" 2>/dev/null && [ ! -e "$f" ]; then
            count=$((count + 1))
        else
            echo "$f cannot be deleted; it still holds the provisioned secrets" >&2
            rc=1
        fi
    done
    if own_dir "$cloud_run"; then
        for name in "${run_copies[@]}"; do
            f=$cloud_run$name
            if [ -f "$f" ] && [ ! -L "$f" ]; then
                if rm -f -- "$f" 2>/dev/null && [ ! -e "$f" ]; then
                    count=$((count + 1))
                else
                    echo "$f cannot be deleted; it still holds the provisioned secrets" >&2
                    rc=1
                fi
            fi
        done
    fi
    printf '%s' "$count"
    return "$rc"
}

# searchable PLACE [NAMED...]: whether the files of PLACE can be searched as
# main's searches go through them (the seed files apart, and not below
# /var/log), with the places NAMED left out. Says nothing: find has named what
# it could not read when the search failed that this is asked for.
searchable() {
    local place=$1 p depth=() skip=()
    shift
    [ "$place" != "${cloud_log%/}" ] || depth=(-maxdepth 1)
    [ "$place" != "${cloud_lib%/}" ] || skip+=(-o -path "${cloud_lib}seed")
    for p in "$@"; do skip+=(-o -path "$p"); done
    if [ "${#skip[@]}" -gt 0 ]; then
        find "$place" -ignore_readdir_race -xdev "${depth[@]}" \( "${skip[@]:1}" \) -prune -o -true >/dev/null 2>&1
    else
        find "$place" -ignore_readdir_race -xdev "${depth[@]}" >/dev/null 2>&1
    fi
}

# unsearched [PLACE [no]]: for main, which holds unscrubbed and failed:
# records that a search in PLACE failed, so that the copies are kept and the
# unit fails. find has named what it could not read (#119), each time it met
# it; this names a place once. Not a PLACE that is named already or lies
# within one that is: that message covers it. One around a place that is
# named, such as /var/lib/cloud after its instances/, fails for the one
# instance directory that cannot be read again; it is named only when it
# cannot be searched with the named places left out either (searchable),
# which is another cause, and the message says so (#173). With "no", it is
# not known that the search of PLACE failed, and PLACE is asked first.
# Without PLACE, the search went through every place and does not say which
# one failed: each is asked, and when none fails any more and none is named
# yet, the failure is named without a place.
unsearched() {
    local place=${1:-} sure=${2:-yes} p within=()
    if [ -z "$place" ]; then
        for p in "$cloud_lib" "$cloud_run" "$cloud_log"; do
            ! own_dir "$p" || unsearched "${p%/}" no
        done
        if [ "${#failed[@]}" -eq 0 ]; then
            place="cloud-init's files and logs"
            failed[$place]=1
            unscrubbed+=("$place cannot be searched (see find's message); what could not be read there is neither scrubbed nor deleted")
        fi
        return 0
    fi
    for p in "${!failed[@]}"; do
        case $place/ in "$p"/*) return 0 ;; esac
        case $p/ in "$place"/*) within+=("$p") ;; esac
    done
    if [ "${#within[@]}" -gt 0 ] || [ "$sure" = no ]; then
        ! searchable "$place" "${within[@]}" || return 0
    fi
    failed[$place]=1
    if [ "${#within[@]}" -gt 0 ]; then
        unscrubbed+=("$place cannot be searched outside ${within[*]} either (see find's message); what could not be read there is neither scrubbed nor deleted")
    else
        unscrubbed+=("$place cannot be searched (see find's message); what could not be read there is neither scrubbed nor deleted")
    fi
}

# told NAME: for main, which holds unscrubbed and untold: takes the
# directories whose file system cannot be told, which foreign marks with a
# "?", out of the array NAME, and records each, once, however many searches
# met it, so that the copies are kept and the unit fails (#170). find printed
# nothing for it: it is stat that failed, on a directory that is still there.
# The message does not say that nothing in it is scrubbed: the searches enter
# it wherever find does, and what they find in it is scrubbed (#184).
told() {
    local -n told_dirs=$1
    local told_d told_rest=()
    for told_d in "${told_dirs[@]}"; do
        case $told_d in
            '?'*)
                told_d=${told_d#'?'}
                if [ -z "${untold[$told_d]:-}" ]; then
                    untold[$told_d]=1
                    unscrubbed+=("the file system of $told_d cannot be told; whether everything in it was searched is not known")
                fi
                ;;
            *) told_rest+=("$told_d") ;;
        esac
    done
    told_dirs=("${told_rest[@]}")
}

main() {
    local pats=() f d rc redacted=0 dropped=0 left=() unwritten=() unscrubbed=() seeded=() deleted copies='' undeleted=''
    local found=() links=() files=() elsewhere=() got=() named
    local -A failed=() untold=()
    list found instance_copies || unsearched "${cloud_lib}instances"
    for f in "${found[@]}"; do
        if is_config "$f"; then copies=yes; fi
    done
    # Without the YAML module that cloud-init itself uses, every copy would
    # count as unreadable and the logs would go on every boot: fail instead.
    if [ -n "$copies" ] && ! python3 -I -c 'import yaml' 2>/dev/null; then
        echo "Python has no YAML module; cloud-init's copies of the cloud-config cannot be read, nothing is scrubbed" >&2
        return 1
    fi
    # Without jq no value would be learned and the copies would go with the
    # values still in the logs (#76): fail instead, and keep everything.
    if { [ -n "$copies" ] || { own_dir "$cloud_run" && [ -f "$combined" ] && [ ! -L "$combined" ]; }; } && ! jq -n 1 >/dev/null 2>&1; then
        echo "jq cannot run; the provisioned secrets cannot be learned, nothing is scrubbed and cloud-init's copies of the provisioning data are kept" >&2
        return 1
    fi
    # Read before anything is deleted: the copies are deleted last, so that a
    # boot that ends before this is through can learn the values again.
    learn "${found[@]}"
    for f in "${unlearned[@]}"; do
        unscrubbed+=("$f: jq cannot take the provisioned secrets out of it; they are not known")
    done
    mapfile -d '' -t pats < <(patterns)
    if ! wait "$!"; then
        pats=()
        unscrubbed+=("the provisioned secrets cannot be made into search patterns (jq or Python failed, or Python made none); none is searched for")
    fi
    # A place that is a symbolic link is not entered (own_dir), and a file
    # that is one is not read, rewritten or deleted through it: what lies
    # behind it keeps what it holds. Each such link is named here, once.
    # Behind a link in place of /var/lib/cloud, its instances/, an instance
    # directory or a copy there can be copies whose values are not known here
    # at all, and so behind /run/cloud-init or a copy in it as a link: kept
    # and named always (#93).
    for d in "$cloud_lib" "${cloud_lib}instances" "$cloud_run"; do
        if [ -L "${d%/}" ]; then unscrubbed+=("${d%/} is a symbolic link; the copies of the provisioning data in it are neither read nor deleted"); fi
    done
    list links linked_instances || unsearched "${cloud_lib}instances"
    for f in "${links[@]}"; do
        unscrubbed+=("$f is a symbolic link; the copies of the provisioning data in it are neither read nor deleted")
    done
    list links linked_copies || unsearched "${cloud_lib}instances"
    for f in "${links[@]}"; do
        unscrubbed+=("$f is a symbolic link; the copy of the provisioning data behind it is neither read nor deleted")
    done
    # A directory on another file system is not entered either (-xdev). In
    # place of an instance directory its copies are neither read nor deleted:
    # kept and named always, like a link there (#119). Any other one, such as
    # /var/lib/cloud/instances itself (its copies are read and deleted, the
    # other files in it are not searched) or /var/lib/cloud/data, is taken
    # below with the places that matter when there is something to scrub.
    if own_dir "$cloud_lib" && own_dir "${cloud_lib}instances"; then
        list got foreign "${cloud_lib}instances" -maxdepth 1 || unsearched "${cloud_lib}instances"
        told got
        for d in "${got[@]}"; do
            unscrubbed+=("$d is on another file system than ${cloud_lib}instances; the copies of the provisioning data in it are neither read nor deleted")
        done
    fi
    if own_dir "$cloud_lib"; then
        list got foreign "$cloud_lib" -path "${cloud_lib}seed" -prune -o || unsearched "${cloud_lib%/}"
        told got
        for d in "${got[@]}"; do
            # An instance directory is named above.
            [ "${d%/*}" = "${cloud_lib}instances" ] || elsewhere+=("$d")
        done
    fi
    if own_dir "$cloud_run"; then
        list got foreign "$cloud_run" || unsearched "${cloud_run%/}"
        told got
        elsewhere+=("${got[@]}")
    fi
    links=()
    if own_dir "$cloud_log"; then
        list links linked_logs || unsearched "${cloud_log%/}"
    fi
    # Behind /var/lib/cloud/data (cloud-init's status and result), /var/log
    # or one of cloud-init's logs as a link, the values stay when there is
    # something to scrub: then the copies stay too. Otherwise the link is
    # only named.
    if [ "${#pats[@]}" -gt 0 ] || [ "${#unknown[@]}" -gt 0 ]; then
        if [ -L "${cloud_log%/}" ]; then unscrubbed+=("${cloud_log%/} is a symbolic link; the provisioned secrets in it are not scrubbed"); fi
        if [ ! -L "${cloud_lib%/}" ] && [ -L "${cloud_lib}data" ]; then
            unscrubbed+=("${cloud_lib}data is a symbolic link; the provisioned secrets in cloud-init's status and result behind it are not scrubbed")
        elif own_dir "$cloud_lib" && own_dir "${cloud_lib}data"; then
            # cloud-init writes these as files; its links to them are in
            # /run/cloud-init.
            for f in "${status_names[@]}"; do
                if [ -L "${cloud_lib}data/$f" ]; then unscrubbed+=("${cloud_lib}data/$f is a symbolic link; the provisioned secrets behind it are not scrubbed"); fi
            done
        fi
        for f in "${links[@]}"; do
            unscrubbed+=("$f is a symbolic link; the provisioned secrets behind it are not scrubbed")
        done
        for d in "${elsewhere[@]}"; do
            unscrubbed+=("$d is on another file system than the directory it is in; the provisioned secrets in it are not scrubbed")
        done
    else
        if [ -L "${cloud_log%/}" ]; then echo "${cloud_log%/} is a symbolic link; it is not entered, and there is nothing to scrub" >&2; fi
        if [ ! -L "${cloud_lib%/}" ] && [ -L "${cloud_lib}data" ]; then
            echo "${cloud_lib}data is a symbolic link; it is not entered, and there is nothing to scrub" >&2
        elif own_dir "$cloud_lib" && own_dir "${cloud_lib}data"; then
            for f in "${status_names[@]}"; do
                if [ -L "${cloud_lib}data/$f" ]; then echo "${cloud_lib}data/$f is a symbolic link; it is not followed, and there is nothing to scrub" >&2; fi
            done
        fi
        for f in "${links[@]}"; do
            echo "$f is a symbolic link; it is not followed, and there is nothing to scrub" >&2
        done
        for d in "${elsewhere[@]}"; do
            echo "$d is on another file system than the directory it is in; it is not entered, and there is nothing to scrub" >&2
        done
    fi
    if [ "${#unknown[@]}" -gt 0 ]; then
        for f in "${unknown[@]}"; do
            echo "$f: no copy of the cloud-config can be read; the provisioned secrets in it are not known, so cloud-init's logs are deleted and the error messages in its status are replaced" >&2
        done
        if own_dir "$cloud_log"; then
            list files logs || unsearched "${cloud_log%/}"
            for f in "${files[@]}"; do
                # Not under set -e: a log that stays is named, and the copies
                # stay with it, so that the next boot retries (#93).
                if rm -f -- "$f" 2>/dev/null && [ ! -e "$f" ]; then
                    echo "deleted $f"
                else
                    unscrubbed+=("$f cannot be deleted; the provisioned secrets in it are not known and stay in it")
                fi
            done
        fi
        # Not under set -e: the status and result that are not handed out
        # stay as they are, and so do the copies. main does not rest on
        # having named the directory above (elsewhere, untold): it is asked
        # again, and named here only when it is not named yet, so that one
        # cause has one message (#170). Which of the two file systems cannot
        # be told is a cause each: /var/lib/cloud named above does not cover
        # /var/lib/cloud/data here, nor the other way round (#184).
        rc=0
        list got status_files || rc=$?
        case $rc in
            0) ;;
            3)
                named=''
                for d in "${elsewhere[@]}"; do
                    if [ "$d" = "${cloud_lib}data" ]; then named=yes; fi
                done
                [ -n "$named" ] || unscrubbed+=("${cloud_lib}data is on another file system than the directory it is in; the error messages in cloud-init's status and result in it are not replaced")
                ;;
            1)
                [ -n "${untold[${cloud_lib%/}]:-}" ] ||
                    unscrubbed+=("the file system of ${cloud_lib%/} cannot be told, and so not whether ${cloud_lib}data is on another one; the error messages in cloud-init's status and result in it are not replaced")
                ;;
            *)
                [ -n "${untold[${cloud_lib}data]:-}" ] ||
                    unscrubbed+=("whether ${cloud_lib}data is on another file system cannot be told; the error messages in cloud-init's status and result in it are not replaced")
                ;;
        esac
        for f in "${got[@]}"; do
            rc=0
            blank_errors "$f" || rc=$?
            case $rc in
                0)
                    ! command -v restorecon >/dev/null || restorecon -F -- "$f" 2>/dev/null || true
                    echo "error messages replaced in $f"
                    ;;
                6) echo "$f is not JSON; its error messages are left as they are" >&2 ;;
                3 | 4) ;;
                *) unwritten+=("$f") ;;
            esac
        done
    fi
    if [ "${#pats[@]}" -gt 0 ]; then
        # A search that fails has not found every file: the copies stay.
        list files scanned || unsearched
        for f in "${files[@]}"; do
            rc=0
            # shellcheck disable=SC2046 # empty or one word
            printf '%s\0' "${pats[@]}" | redact "$f" $(log_kind "$f") || rc=$?
            case $rc in
                0)
                    redacted=$((redacted + 1))
                    # The rewritten file takes the label of its directory;
                    # give it back its own, such as that of cloud-init's log.
                    ! command -v restorecon >/dev/null || restorecon -F -- "$f" 2>/dev/null || true
                    echo "provisioned secrets replaced in $f"
                    ;;
                5)
                    dropped=$((dropped + 1))
                    echo "deleted $f: a compressed file that holds provisioned secrets or cannot be read"
                    ;;
                3 | 4) ;;
                *) left+=("$f") ;;
            esac
        done
        # Searched again: a compressed log that was deleted is gone.
        list files scanned || unsearched
        for f in "${files[@]}"; do
            # shellcheck disable=SC2046 # empty or one word
            if printf '%s\0' "${pats[@]}" | holds "$f" $(log_kind "$f"); then left+=("$f"); fi
        done
        if own_dir "$cloud_lib" && own_dir "${cloud_lib}seed"; then
            # The seed files are only warned about: a part of them that is
            # not looked into is one more warning, and fails nothing.
            list files find "${cloud_lib}seed" -ignore_readdir_race -xdev -type f -print0 ||
                echo "warning: ${cloud_lib}seed cannot be searched (see find's message); not every seed file is looked into" >&2
            for f in "${files[@]}"; do
                if printf '%s\0' "${pats[@]}" | holds "$f"; then seeded+=("$f"); fi
            done
            list got foreign "${cloud_lib}seed" || true
            for d in "${got[@]}"; do
                case $d in
                    '?'*) echo "warning: the file system of ${d#'?'} cannot be told; whether every seed file in it is looked into is not known" >&2 ;;
                    *) echo "warning: $d is on another file system than ${cloud_lib}seed; the seed files in it are not looked into" >&2 ;;
                esac
            done
        elif [ ! -L "${cloud_lib%/}" ] && [ -L "${cloud_lib}seed" ]; then
            echo "warning: ${cloud_lib}seed is a symbolic link; the seed files behind it are not looked into" >&2
        fi
    fi
    # A file that still holds a value, or whose error messages could not be
    # replaced, keeps the copies, so that the next boot can learn the values
    # again, or find them unknown again, and retry; so do values that are not
    # known and places that are not scrubbed (unscrubbed).
    if [ "${#left[@]}" -eq 0 ] && [ "${#unwritten[@]}" -eq 0 ] && [ "${#unscrubbed[@]}" -eq 0 ]; then deleted=$(delete_copies) || undeleted=yes; else deleted=0; fi
    echo "cloud-init's copies of the provisioning data deleted: $deleted; files with provisioned secrets replaced: $redacted"
    [ "$dropped" = 0 ] || echo "compressed logs with provisioned secrets deleted: $dropped"
    for f in "${seeded[@]}"; do
        echo "warning: the seed file $f holds provisioned secrets in plain text; once the appliance has started, delete the seed files and the configuration file that names them (it keeps its settings without them)" >&2
    done
    # delete_copies has named the copies it could not delete.
    [ -z "$undeleted" ] || return 1
    if [ "${#left[@]}" -gt 0 ] || [ "${#unwritten[@]}" -gt 0 ] || [ "${#unscrubbed[@]}" -gt 0 ]; then
        for f in "${left[@]}"; do echo "$f still holds provisioned secrets" >&2; done
        for f in "${unwritten[@]}"; do echo "$f cannot be rewritten; its error messages are not replaced" >&2; done
        for f in "${unscrubbed[@]}"; do echo "$f" >&2; done
        echo "cloud-init's copies of the provisioning data are kept until the next boot retries" >&2
        return 1
    fi
}

main
