#!/usr/bin/bash
# Generates the secrets the Kamerplanter services need. Runs once, before
# any container starts, so that no installation shares a credential.
set -euo pipefail
umask 077

rand() { od -An -N"$1" -tx1 /dev/urandom | tr -d ' \n'; }

install -d -m 0700 /etc/kamerplanter
db_password=$(rand 24)
tmp=$(mktemp /etc/kamerplanter/.secrets.XXXXXX)
cat >"$tmp" <<EOF
ARANGO_ROOT_PASSWORD=${db_password}
ARANGODB_PASSWORD=${db_password}
ERASURE_TOMBSTONE_SALT=$(rand 32)
LOG_PSEUDONYM_SALT=$(rand 32)
EOF
mv "$tmp" /etc/kamerplanter/secrets.env
