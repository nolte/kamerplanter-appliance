#!/usr/bin/bash
# Prepares the configuration of the Kamerplanter services.
#
#   configure           run by kamerplanter-config.service on every boot and on
#                       `systemctl restart kamerplanter.target`
#   configure pin KEY…  run by a service right before it starts, to record the
#                       values it starts with, which must not change from then on
#
# Layers, later wins (config_layers in /usr/lib/kamerplanter/env.sh):
#   /usr/share/kamerplanter/kamerplanter.env  defaults, part of the image
#   /var/lib/kamerplanter/provisioning/       the provisioning layer: the
#       provisioning.env                      write_files target, then
#       settings.env                          kamerplanter: -> settings: of
#                                             the provisioning data, renewed
#                                             at boot by
#                                             kamerplanter-provisioning.service
#   /etc/kamerplanter/secrets.env             generated here, once per key,
#                                             or taken over from the
#                                             provisioned secrets
#   /etc/kamerplanter/kamerplanter.env        the user's own values
# A provisioned value is checked like a value of the user file, and a
# message about it names the provisioning layer. The provisioning layer never
# names a disk: its DATA_DISK, BACKUP_DISK and *_FORCE are ignored with a
# message. A generated secret set there is passed through, with a warning
# that names the key, never the value, and points to kamerplanter: -> secrets:.
#
# Provisioned secrets (spec/distribution-requirements/ L12-L14, L17) come
# through two channels: the map kamerplanter: -> secrets: of the provisioning
# data, which kamerplanter-provisioning.service stages in memory
# (staged_secrets in /usr/lib/kamerplanter/env.sh) and which is taken over
# once per instance; and the system credentials kamerplanter.secret.<KEY>,
# which kamerplanter-config.service imports, read on every run. A credential
# wins over the map for the same key. Either only fills a key that the
# secrets file does not hold: a value the file holds is kept, with a warning
# that names the key; a provisioned value of a pinned key that differs from
# the recorded one is never written, and keeps the services stopped when no
# layer holds that key. Only the secrets of provisionable_secret_keys are
# taken over, and only values that pass the checks below; anything else
# keeps the services stopped and nothing provisioned is written. A value is
# never printed, nor passed on a command line.
#
# With a data disk, /etc/kamerplanter and /var/lib/kamerplanter/pinned are
# bound from it by kamerplanter-data-disk.service
# (/usr/libexec/kamerplanter/disks): the paths stay, the files live on the disk.
# The provisioning layer stays on the system disk.
#
# The merged result is written to /run/kamerplanter/, and the container units
# read only those files, so what this script checks is exactly what the
# services receive. The layers are parsed by /usr/lib/kamerplanter/env.sh, the
# parser every reader of them shares.
set -euo pipefail
umask 077

pins=/var/lib/kamerplanter/pinned
out=/run/kamerplanter

# Values that must not change once a service has started with them. A change
# stops the services instead of damaging the data. To change one deliberately,
# do what its reason says, then delete its pin in $pins (pin_files below).
declare -A pinned=(
    [ERASURE_TOMBSTONE_SALT]="it keys the records of deleted accounts and must never change"
    [FERNET_KEY]="stored credentials are encrypted with it and become unreadable"
    [ARANGODB_PASSWORD]="the database keeps the password it was created with; change it in the database first"
)

hex() { od -An -N"$1" -tx1 /dev/urandom | tr -d ' \n'; }
# A Fernet key is 32 random bytes in URL-safe base64.
fernet() { head -c 32 /dev/urandom | base64 | tr '+/' '-_'; }

errors=()
fail() { errors+=("$1"); }

# Replaces a file with what stdin delivers, durably: a reader sees either the
# old or the new content, and the new content survives a power loss. Fails,
# also in a condition, when a step does.
replace() {
    local tmp
    tmp=$(mktemp "$(dirname "$1")/.$(basename "$1").XXXXXX") || return 1
    if cat >"$tmp" && sync "$tmp" && mv "$tmp" "$1" && sync "$(dirname "$1")"; then
        return 0
    fi
    rm -f -- "$tmp"
    return 1
}

# shellcheck source=image/rootfs/usr/lib/kamerplanter/env.sh
. /usr/lib/kamerplanter/env.sh

# --- The pins ---
# A pin is the HMAC-SHA256 (RFC 2104) of the value, in $pins/KEY.hmac, keyed
# with a random key of this device in $pin_key, so that a pin does not give
# away its value, not even a short one, to whoever tries values against it.
# The key lies with the pins, so it moves onto a data disk and is adopted
# with them (data_disk_places in /usr/lib/kamerplanter/env.sh); it is
# generated once, before any service starts, and never printed, nor passed
# on a command line: only builtins and sha256sum on its input see it.
# Releases before recorded the unsalted SHA-256 in $pins/KEY. Such a legacy
# pin is still checked; once the value matches it, the keyed pin is written
# beside it, without stopping anything. A release before reads only
# $pins/KEY, so the legacy pin is deleted only while no update is being
# checked ($update_pending, kept by /usr/bin/kamerplanter-update): the
# release an automatic rollback returns to still finds it and keeps
# refusing to generate or change the value. After a later rollback to such
# a release, it checks no migrated value and pins it again in the old form
# when its service starts; the next run here checks both and migrates again.
pin_key=$pins/.key
update_pending=/var/lib/kamerplanter/update/pending
pin_key_hex=
# pin_key_read: sets pin_key_hex from $pin_key; fails when it holds no key.
pin_key_read() {
    local k
    [ -f "$pin_key" ] || return 1
    k=$(<"$pin_key") || return 1
    [[ $k =~ ^[0-9a-f]{64}$ ]] || return 1
    pin_key_hex=$k
}
keyed_pins() { compgen -G "$pins/*.hmac" >/dev/null; }
# pin_key_make: generates the key unless there is one. A keyed pin without
# its key is never given a new one: it could not match any more. Called in
# a condition, so every step is checked.
# A new key is renamed into place without replacing one that another run
# made in the meantime (mv -n, whose exit status pin_key_read stands in
# for), and never as a second link, which a data disk would refuse; only a
# damaged key is replaced.
pin_key_make() {
    local tmp
    [ -z "$pin_key_hex" ] || return 0
    pin_key_read && return 0
    ! keyed_pins || return 1
    if [ -d "$pin_key" ] && [ ! -L "$pin_key" ]; then
        return 1
    elif [ -e "$pin_key" ] || [ -L "$pin_key" ]; then
        hex 32 | replace "$pin_key" || return 1
    else
        tmp=$(mktemp "$pins/.key.XXXXXX") || return 1
        if hex 32 >"$tmp" && sync "$tmp"; then mv -n -- "$tmp" "$pin_key" 2>/dev/null || true; fi
        rm -f -- "$tmp"
        sync "$pins" || true
    fi
    pin_key_read
}
pin_key_missing="the key of the pins, $pin_key, is missing or damaged although keyed pins are recorded in $pins: restore it from your backup, or, when the values in $config_secrets are those Kamerplanter started with, delete the files $pins/*.hmac and restart"
# hmac VALUE: the keyed pin of VALUE, 64 hex digits.
hmac() {
    local i b ipad='' opad='' inner bin='' x
    [ -n "$pin_key_hex" ] || return 1
    for ((i = 0; i < 128; i += 2)); do
        b=0
        if ((i < 64)); then b=$((16#${pin_key_hex:i:2})); fi
        printf -v x '\\x%02x' $((b ^ 0x36))
        ipad+=$x
        printf -v x '\\x%02x' $((b ^ 0x5c))
        opad+=$x
    done
    inner=$({ printf '%b' "$ipad"; printf '%s' "$1"; } | sha256sum) || return 1
    inner=${inner%% *}
    [[ $inner =~ ^[0-9a-f]{64}$ ]] || return 1
    for ((i = 0; i < 64; i += 2)); do bin+="\\x${inner:i:2}"; done
    x=$({ printf '%b' "$opad"; printf '%b' "$bin"; } | sha256sum) || return 1
    x=${x%% *}
    [[ $x =~ ^[0-9a-f]{64}$ ]] || return 1
    printf '%s\n' "$x"
}
# pinned_now KEY: whether a pin of KEY is recorded, keyed or legacy.
pinned_now() { [ -e "$pins/$1.hmac" ] || [ -e "$pins/$1" ]; }
# pin_files KEY: the pin files of KEY to delete to release it, for a message.
pin_files() {
    if [ -e "$pins/$1" ] && [ -e "$pins/$1.hmac" ]; then
        printf '%s and %s' "$pins/$1.hmac" "$pins/$1"
    elif [ -e "$pins/$1" ]; then
        printf '%s' "$pins/$1"
    else
        printf '%s' "$pins/$1.hmac"
    fi
}
# pin_matches KEY VALUE: whether VALUE is the one pinned for KEY. A legacy
# pin, where there is one, decides: it is what a release before checks, and
# pins anew when a value is changed there after a rollback; a keyed pin
# beside it that differs is then older than it and is written anew
# (keyed_matches, below). Without a legacy pin the keyed one decides.
pin_matches() {
    local h
    if [ -e "$pins/$1" ]; then
        h=$(printf '%s' "$2" | sha256sum) || return 1
        [ "$(<"$pins/$1")" = "${h%% *}" ] || return 1
        return 0
    fi
    [ -e "$pins/$1.hmac" ] || return 0
    keyed_matches "$1" "$2"
}
# keyed_matches KEY VALUE: whether the keyed pin of KEY is that of VALUE.
keyed_matches() {
    local h
    [ -e "$pins/$1.hmac" ] || return 1
    h=$(hmac "$2") || return 1
    [ "$(<"$pins/$1.hmac")" = "$h" ]
}
# pin_record KEY VALUE: records the keyed pin of VALUE for KEY. Called in a
# condition, so every step is checked.
pin_record() {
    local h
    pin_key_make || return 1
    h=$(hmac "$2") || return 1
    printf '%s\n' "$h" | replace "$pins/$1.hmac"
}
secrets=$config_secrets
user=$config_user

# The secrets generated below (spec/distribution-requirements/ D9).
secret_keys=("${generated_secret_keys[@]}")

# secret_problem KEY VALUE: sets problem to what is wrong with VALUE as the
# secret KEY, empty when nothing is or KEY is no secret checked here. The
# check of the configuration and the take-over of provisioned secrets apply
# the same rules. Never a value in problem: it goes to the journal.
problem=
secret_problem() {
    problem=
    case $1 in
        JWT_SECRET_KEY)
            [ "$2" != change-me-in-production-use-openssl-rand-hex-32 ] && [ -n "$2" ] ||
                problem="JWT_SECRET_KEY is empty or the upstream placeholder" ;;
        FERNET_KEY)
            [[ $2 =~ ^[A-Za-z0-9_-]{43}=$ ]] ||
                problem="FERNET_KEY is not a Fernet key (32 bytes, URL-safe base64, 44 characters)" ;;
        ERASURE_TOMBSTONE_SALT | LOG_PSEUDONYM_SALT)
            [ "${#2}" -ge 32 ] || problem="$1 is shorter than 32 characters" ;;
        TENANT_EXPORT_SIGNING_SECRET)
            [ -z "$2" ] || [ "${#2}" -ge 32 ] ||
                problem="TENANT_EXPORT_SIGNING_SECRET is set but shorter than 32 characters" ;;
        ARANGODB_PASSWORD)
            case $2 in '' | rootpassword | changeme) problem="ARANGODB_PASSWORD is empty or a known default" ;; esac ;;
    esac
}

# The minimum length of a secret that secret_problem accepts in any length
# (spec/distribution-requirements/ D12): a short HS256 key can be guessed
# offline from one token, a short password online. The generated values are
# far longer (hex 32 and hex 24 below).
declare -A secret_min=([JWT_SECRET_KEY]=32 [ARANGODB_PASSWORD]=16)

# short_secret KEY VALUE: sets problem when VALUE is shorter than the minimum
# length of the secret KEY, empty otherwise. Never a value in problem.
short_secret() {
    problem=
    local min=${secret_min[$1]-}
    [ -z "$min" ] || [ "${#2}" -ge "$min" ] || problem="$1 is shorter than $min characters"
}

# started: true once a service has started, which pinned its values. From
# then on a short secret is only warned about, wherever it comes from: the
# installation already runs with it, and stopping it would roll back every
# update (D12, L14).
# The glob skips dotfiles (dotglob is never set here), so the key of the
# pins alone, $pin_key, does not count.
started() { compgen -G "$pins/*" >/dev/null; }

# check_secret KEY: checks the value of the secret KEY in the effective
# configuration. What secret_problem finds keeps the services stopped; a value
# below the minimum length does so only when the provisioning layer supplies
# it to an installation that has not started yet. Otherwise it is only warned
# about, so that an installation keeps starting with it; the advice for a
# pinned key names what has to change first.
check_secret() {
    local value from
    value=$(get "$1")
    secret_problem "$1" "$value"
    if [ -n "$problem" ]; then
        fail_key "$1" "$problem"
        return
    fi
    short_secret "$1" "$value"
    [ -n "$problem" ] || return 0
    from=$(source_of "$1")
    if [ -n "$from" ] && provisioning_source "$from" && ! started; then
        fail_key "$1" "$problem"
    elif [ -n "${pinned[$1]+set}" ]; then
        echo "warning: $problem and can be guessed; ${pinned[$1]}, then set the new value and remove $(pin_files "$1") (see the configuration reference)" >&2
    else
        echo "warning: $problem and can be guessed; replace it with a longer value (see the configuration reference)" >&2
    fi
}

# provisioned_problem KEY VALUE: as secret_problem, for a provisioned secret,
# which must also be one line of 1 to 4096 printable ASCII characters, so it
# is taken into the secrets file literally and as one line, and at least as
# long as the minimum length of KEY until the installation has started; after
# that, check_secret warns about a short one.
provisioned_problem() {
    local LC_ALL=C
    problem=
    if [ -z "$2" ]; then
        problem="$1 is empty"
    elif [ "${#2}" -gt 4096 ]; then
        problem="$1 is longer than 4096 characters"
    elif [[ $2 == *[![:print:]]* ]]; then
        problem="$1 holds a character that is not printable ASCII, such as a line break"
    else
        secret_problem "$1" "$2"
        [ -n "$problem" ] || started || short_secret "$1" "$2"
    fi
}

# key_shown KEY: a key named by the provisioning data, as a message shows it.
key_shown() {
    if [[ $1 =~ ^[A-Za-z_][A-Za-z0-9_]{0,63}$ ]]; then printf '%s' "$1"; else printf 'a key that is no KEY name'; fi
}

# layer_name FILE: the file of the provisioning layer in a message.
layer_name() {
    case $1 in
        "$provisioning_settings") printf 'the provisioning layer (kamerplanter: -> settings: of the provisioning data, in %s)' "$1" ;;
        *) printf 'the provisioning layer (%s)' "$1" ;;
    esac
}

# A failure about a value that the provisioning layer supplies names it, and
# the closing advice then tells how to change a provisioned value.
provisioned_errors=0
fail_key() {  # fail_key KEY MESSAGE
    local from
    from=$(source_of "$1")
    if [ -n "$from" ] && provisioning_source "$from"; then
        provisioned_errors=1
        fail "$2 (set in $(layer_name "$from"))"
    else
        fail "$2"
    fi
}

# report_invalid: says why the configuration is invalid and keeps the
# services stopped.
secret_errors=0
report_invalid() {
    printf 'Kamerplanter configuration is invalid; the services stay stopped:\n' >&2
    printf '  - %s\n' "${errors[@]}" >&2
    if [ "$secret_errors" = 1 ]; then
        printf 'Fix the provisioned secret, in the provisioning data (kamerplanter: -> secrets: is read again at the next boot until it is taken over) or as the system credential %s<KEY>, and reboot; nothing provisioned is written to %s until then\n' "$secret_credentials" "$secrets" >&2
    elif [ "${provisioned_lines-0}" = 1 ]; then
        # A line that is no KEY=VALUE has no key that another layer could
        # set instead: only the provisioning data itself can fix it.
        printf 'Fix the entry in the provisioning data (kamerplanter: -> settings: is read again at the next boot; %s is written once per instance and may be edited in place), and reboot\n' "$provisioning_file" >&2
    elif [ "$provisioned_errors" = 1 ]; then
        printf 'Fix a provisioned value in the provisioning data (kamerplanter: -> settings: is read again at the next boot; %s is written once per instance and may be edited in place), or set it in %s, which wins over it, and run: systemctl restart kamerplanter.target\n' "$provisioning_file" "$user" >&2
    else
        printf 'Fix %s and run: systemctl restart kamerplanter.target\n' "$user" >&2
    fi
    rm -f "$out"/*.env
    exit 1
}

# A data disk that is set up but not mounted, or whose locations are not all
# bound from it, is never replaced by the system disk: nothing is generated or
# written (spec/distribution-requirements/ E12), so no secret and no pin lands
# on the system disk underneath /etc/kamerplanter or $pins.
# kamerplanter-config.service requires kamerplanter-data-disk.service, which
# mounts the disk and binds its locations; this holds however configure is
# started.
if ! data_disk_placed; then
    echo "data disk kp-data is missing or not in place; the services stay stopped and nothing is generated." >&2
    echo "Attach it, then run: systemctl restart kamerplanter.target (details: systemctl status kamerplanter-data-disk.service)" >&2
    exit 1
fi

if [ "${1-}" = pin ]; then
    # Pin what the services were started with, not what the files say now.
    shift
    install -d -m 0700 "$pins"
    load "$out/app.env"
    for key in "$@"; do
        pinned_now "$key" && continue
        if [ -z "$(get "$key")" ]; then
            echo "not pinning $key: it has no value in $out/app.env" >&2
            exit 1
        fi
        if ! pin_record "$key" "$(get "$key")"; then
            if pin_key_read || ! keyed_pins; then
                echo "not pinning $key: $pins/$key.hmac could not be written" >&2
            else
                echo "not pinning $key: $pin_key_missing" >&2
            fi
            exit 1
        fi
    done
    exit 0
fi

install -d -m 0700 /etc/kamerplanter "$pins" "$out"
[ -e "$user" ] || install -m 0600 /dev/null "$user"
[ -e "$secrets" ] || install -m 0600 /dev/null "$secrets"
# A keyed pin can be checked only with its key.
if ! pin_key_read && keyed_pins; then
    fail "$pin_key_missing"
    report_invalid
fi

# --- The provisioned secrets (L12, L13, L14, L17) ---
# Taken over here, after the check above that the data disk is in place, so
# they fill the secrets file on the data disk, also one adopted from it
# (E10), and never one on the system disk underneath.
fail_secret() { secret_errors=1; fail "$1"; }
declare -A offered=() offered_from=()
offer() {  # offer KEY VALUE FROM: VALUE is supplied for KEY; a later offer wins
    if provisionable_secret "$1"; then
        offered[$1]=$2
        offered_from[$1]=$3
        return
    fi
    fail_secret "$(key_shown "$1") in $3 is no secret the appliance takes over (it takes over ${provisionable_secret_keys[*]})"
}
staged=no
if [ -f "$staged_secrets" ] && [ ! -L "$staged_secrets" ]; then
    staged=yes
    while IFS= read -r line || [ -n "$line" ]; do
        [ -n "$line" ] || continue
        key=${line%%=*}
        if [[ $line == *=* && $key =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
            offer "$key" "${line#*=}" "kamerplanter: -> secrets: of the provisioning data"
        elif [[ $line == "invalid entry of "* ]]; then
            fail_secret "$line"  # the provisioning step's message, never a value
        else
            # Never shown: a line that is neither may hold a value.
            fail_secret "invalid entry of kamerplanter: -> secrets:, a line that is no KEY=VALUE line (not shown)"
        fi
    done <"$staged_secrets"
fi
# A credential is taken as it is, without its trailing line breaks.
if [ -n "${CREDENTIALS_DIRECTORY-}" ] && [ -d "$CREDENTIALS_DIRECTORY" ]; then
    for file in "$CREDENTIALS_DIRECTORY/$secret_credentials"*; do
        [ -f "$file" ] || continue
        key=${file##*/"$secret_credentials"}
        from="the system credential $secret_credentials$(key_shown "$key")"
        if [ "$(wc -c <"$file")" -gt 4097 ]; then
            fail_secret "$(key_shown "$key") is longer than 4096 characters (supplied by $from)"
        elif [ "$(LC_ALL=C tr -d '\040-\176\n' <"$file" | wc -c)" -gt 0 ]; then
            fail_secret "$(key_shown "$key") holds a character that is not printable ASCII (supplied by $from)"
        else
            value=$(<"$file")
            offer "$key" "$value" "$from"
        fi
    done
fi
load "$secrets"
declare -A held=()
for key in "${!cfg[@]}"; do held[$key]=${cfg[$key]}; done
load_config
taken=()
taken_keys=()
while IFS= read -r key; do
    [ -n "$key" ] || continue
    value=${offered[$key]}
    from=${offered_from[$key]}
    if [ -n "${held[$key]+set}" ]; then
        [ "${held[$key]}" = "$value" ] ||
            echo "warning: $key from $from differs from the value in $secrets; that value is kept, the provisioned one is not used" >&2
        continue
    fi
    provisioned_problem "$key" "$value"
    if [ -n "$problem" ]; then
        fail_secret "$problem (supplied by $from)"
        continue
    fi
    # A pinned value is restored only as the value Kamerplanter started with.
    if [ -n "${pinned[$key]+set}" ] && pinned_now "$key" && ! pin_matches "$key" "$value"; then
        if [ -n "${cfg[$key]+set}" ]; then
            echo "warning: $key from $from differs from the value Kamerplanter started with; it is not taken over" >&2
        else
            fail_secret "$key from $from differs from the value Kamerplanter started with: ${pinned[$key]}; restore $key from your backup into $secrets"
        fi
        continue
    fi
    taken+=("$key=$value")
    taken_keys+=("$key ($from)")
done < <(printf '%s\n' "${!offered[@]}" | sort)
[ "$secret_errors" = 0 ] || report_invalid
# Written durably, before anything is generated or any service starts.
if [ ${#taken[@]} -gt 0 ]; then
    { awk 1 "$secrets"; printf '%s\n' "${taken[@]}"; } | replace "$secrets"
    list=$(printf '%s; ' "${taken_keys[@]}")
    echo "provisioned secrets taken over into $secrets: ${list%; }"
fi
taken=()
offered=()
value=
# The map of this instance is taken over now: recorded, so it is not again,
# and deleted from memory.
if [ "$staged" = yes ]; then
    instance=$(head -n1 -- "$staged_instance" 2>/dev/null) || instance=
    [ -n "$instance" ] || instance=null
    if [ -d "$provisioning_dir" ] && [ ! -L "$provisioning_dir" ]; then
        printf '%s\n' "$instance" | replace "$secrets_taken"
    else
        echo "$provisioning_dir is not a directory: the take-over of kamerplanter: -> secrets: is not recorded and is repeated at the next boot" >&2
    fi
    rm -f -- "$staged_secrets" "$staged_instance"
    rmdir -- "$provisioning_staging" 2>/dev/null || true
fi

# The generated secrets that the provisioning layer sets, whichever layer
# wins for them, as "KEY FILE".
load "${provisioning_layer[@]}"
provisioned_secrets=()
for key in "${secret_keys[@]}"; do
    from=$(source_of "$key")
    if [ -n "$from" ]; then provisioned_secrets+=("$key $from"); fi
done

# A missing value is generated, except one that is already pinned: a new
# FERNET_KEY or salt would not match the stored data, so it has to come back
# from a backup instead.
load_config
missing() {
    [ -z "${cfg[$1]+set}" ] || return 1
    if [ -n "${pinned[$1]+set}" ] && pinned_now "$1"; then
        fail "$1 is missing from $secrets although Kamerplanter already started with it: ${pinned[$1]}; restore it from your backup"
        return 1
    fi
}
generated=()
missing ARANGODB_PASSWORD && generated+=("ARANGODB_PASSWORD=$(hex 24)")
missing JWT_SECRET_KEY && generated+=("JWT_SECRET_KEY=$(hex 32)")
missing FERNET_KEY && generated+=("FERNET_KEY=$(fernet)")
missing ERASURE_TOMBSTONE_SALT && generated+=("ERASURE_TOMBSTONE_SALT=$(hex 32)")
missing LOG_PSEUDONYM_SALT && generated+=("LOG_PSEUDONYM_SALT=$(hex 32)")
# Written before any service can start with them, and durably, so a pin can
# never outlive the secret it protects. The existing content is kept as it is,
# with a line break added where its last line lacks one.
if [ ${#generated[@]} -gt 0 ]; then
    { awk 1 "$secrets"; printf '%s\n' "${generated[@]}"; } | replace "$secrets"
fi
load_config
for line in "${cfg_invalid[@]}"; do
    case $line in "line "*" of $provisioning_dir/"*) provisioned_errors=1 provisioned_lines=1 line="$line, in the provisioning layer" ;; esac
    fail "$line"
done
# Never a value in these messages: they go to the journal.
for entry in "${cfg_ignored[@]}"; do
    key=${entry%% *}
    case $key in BACKUP_DISK*) role=backup cred=kamerplanter.backup-disk ;; *) role=data cred=kamerplanter.data-disk ;; esac
    [[ $key == *_FORCE ]] && cred=$cred-force
    echo "$key in $(layer_name "${entry#* }") is ignored: provisioning data never names a disk; name the $role disk with: /usr/libexec/kamerplanter/disks name $role PATH [force], or as the system credential $cred" >&2
done
for entry in "${provisioned_secrets[@]}"; do
    echo "warning: the secret ${entry%% *} is set in $(layer_name "${entry#* }"); it is passed through like any setting, but it stays there in plain text and is read again on every boot: supply it under kamerplanter: -> secrets: instead" >&2
done

# The ArangoDB image creates only its root user, with ARANGO_ROOT_PASSWORD.
# The application logs in as that user, so one password serves both.
if [ "$(get ARANGODB_USERNAME)" != root ]; then
    fail_key ARANGODB_USERNAME "ARANGODB_USERNAME must be root: the appliance creates no other database user"
fi
cfg[ARANGO_ROOT_PASSWORD]=$(get ARANGODB_PASSWORD)

for key in JWT_SECRET_KEY FERNET_KEY ERASURE_TOMBSTONE_SALT LOG_PSEUDONYM_SALT TENANT_EXPORT_SIGNING_SECRET; do
    check_secret "$key"
done
[[ $(get UPDATE_WINDOW) =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]] ||
    fail_key UPDATE_WINDOW "UPDATE_WINDOW is not a time of day as HH:MM (the window starts at 03:00 until it is fixed)"
# Bounded like kamerplanter-update reads them (count there): a larger
# timeout would overflow its arithmetic, a longer keeping period is not used.
[[ $(get UPDATE_HEALTH_TIMEOUT) =~ ^[1-9][0-9]{0,3}$ ]] ||
    fail_key UPDATE_HEALTH_TIMEOUT "UPDATE_HEALTH_TIMEOUT is not a whole number of minutes from 1 to 9999"
[[ $(get UPDATE_BACKUP_KEEP_DAYS) =~ ^[1-9][0-9]{0,5}$ ]] ||
    fail_key UPDATE_BACKUP_KEEP_DAYS "UPDATE_BACKUP_KEEP_DAYS is not a whole number of days from 1 to 999999"
# Checked for their form only; kamerplanter-data-disk.service and
# kamerplanter-backup-disk.service decide whether a named disk is used. Not
# checked when the user file lies on the data disk: the disk service ignores
# them there (user_file_trusted), so they cannot keep the services stopped.
if user_file_trusted; then
    for key in DATA_DISK BACKUP_DISK; do
        value=$(get "$key")
        [ -z "$value" ] || disk_path_ok "$value" ||
            fail "$key is not a /dev/disk/by-id/ or /dev/disk/by-uuid/ path"
        [[ $(get "${key}_FORCE") =~ ^[01]?$ ]] || fail "${key}_FORCE is neither 0 nor 1"
    done
fi
check_secret ARANGODB_PASSWORD

legacy=()
for key in "${!pinned[@]}"; do
    pinned_now "$key" || continue
    [ -n "${cfg[$key]+set}" ] || continue
    if pin_matches "$key" "$(get "$key")"; then
        [ ! -e "$pins/$key" ] || legacy+=("$key")
    else
        fail_key "$key" "$key differs from the value Kamerplanter started with: ${pinned[$key]} (then remove $(pin_files "$key"))"
    fi
done

[ ${#errors[@]} -eq 0 ] || report_invalid

# The key of the pins exists before any service starts, so the services
# never generate it, and a legacy pin that matched gets its keyed one; it is
# deleted once no update is being checked (see "The pins" above). Neither
# stops the services when it cannot be written: a legacy pin stays valid
# and is migrated on a later run.
pin_key_make || echo "warning: the key of the pins could not be written to $pin_key; the services pin their values when they start" >&2
for key in "${legacy[@]}"; do
    if ! keyed_matches "$key" "$(get "$key")"; then
        stale=no
        [ ! -e "$pins/$key.hmac" ] || stale=yes
        if ! pin_record "$key" "$(get "$key")"; then
            echo "warning: the pin of $key could not be migrated; $pins/$key is kept and checked as before" >&2
            continue
        fi
        [ "$stale" = no ] ||
            echo "the keyed pin of $key was older than $pins/$key, which a release before pinned after a rollback; $pins/$key.hmac is written anew"
    fi
    if [ -e "$update_pending" ]; then
        echo "the pin of $key is keyed in $pins/$key.hmac; $pins/$key is kept until the update being checked is decided, for the release a rollback returns to"
    elif rm -f -- "$pins/$key"; then
        echo "the pin of $key is now keyed: $pins/$key.hmac replaces $pins/$key"
    else
        echo "warning: $pins/$key could not be deleted; it is checked as before" >&2
    fi
done

# The application containers get the whole configuration; ArangoDB only the
# value it needs to create its database.
printf '%s\n' "${!cfg[@]}" | sort | while IFS= read -r key; do
    printf '%s=%s\n' "$key" "${cfg[$key]}"
done | replace "$out/app.env"
printf 'ARANGO_ROOT_PASSWORD=%s\n' "$(get ARANGO_ROOT_PASSWORD)" | replace "$out/arangodb.env"
